<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SyndicateLauncher</AssemblyName>
    <RootNamespace>SyndicateLauncher</RootNamespace>
    <ApplicationIcon>Assets\syndicate.ico</ApplicationIcon>
    <Version>1.3.1</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Product>Syndicate Launcher</Product>
    <Company>Syndicate</Company>
    <Authors>Unkn0wn (d4shyb0i), Joey, Sact, Trent, Alfie</Authors>
    <Copyright>Copyright (c) 2026 Unkn0wn, Joey, Sact, Trent, and Alfie (Syndicate). All rights reserved.</Copyright>
    <Trademark>Syndicate</Trademark>
    <AssemblyTitle>Syndicate Launcher</AssemblyTitle>
    <Description>Syndicate Launcher. Made by Unkn0wn, Joey, Sact, Trent, and Alfie. Unauthorized redistribution or rebranding is prohibited.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- UPDATE FROM GIT.cmd builds with -p:SyndicateDevBuild=true: shows the DEV LAUNCHER badge. Release builds (build.bat) don't. -->
