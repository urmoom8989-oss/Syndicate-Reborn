<UserControl x:Class="SyndicateLauncher.Views.CosmeticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" KeyDown="OnKeyDown" IsVisibleChanged="OnIsVisibleChanged">
    <!-- Cosmetics editor (ViewModels/MainViewModel.Cosmetics.cs): every cosmetic a season's game files have, as picture
         tiles. Locker mode adds items to the player's locker or takes them out; Item shop mode picks the season's shop.
         DataContext is MainViewModel. -->
    <Border CornerRadius="16" Background="{DynamicResource Tint_F2161616}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
        <Grid Margin="24,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="COSMETICS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding CosmeticsTitle}" FontFamily="{StaticResource BurbankFont}" FontSize="40"
                               Foreground="{DynamicResource TextBrush}" Margin="0,-2,0,-6" />
                </StackPanel>
                <ComboBox DockPanel.Dock="Left" Style="{StaticResource DarkComboBox}" Width="240" Height="34" FontSize="12" Margin="22,0,0,0"
                          VerticalAlignment="Center" ItemsSource="{Binding GameModeSeasons}" SelectedItem="{Binding SelectedShopSeason, Mode=TwoWay}"
                          AutomationProperties.Name="Season" />
                <TextBox DockPanel.Dock="Left" Style="{StaticResource GlassTextBox}" Width="240" Height="34" FontSize="12" Margin="10,0,0,0"
                         VerticalAlignment="Center" Text="{Binding CosmeticsSearch, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search" ToolTip="Search by name" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" Height="34" VerticalAlignment="Center"
                        Command="{Binding CloseCosmeticsCommand}" ToolTip="Close (Esc)" AutomationProperties.Name="Close">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
            </DockPanel>

            <!-- Types -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding CosmeticTypes}" Focusable="False" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource ChipRadio}" Content="{Binding}" Height="28" Padding="12,0" Margin="0,0,6,6" FontSize="11"
                                     GroupName="CosmeticTypes" CommandParameter="{Binding}"
                                     Command="{Binding DataContext.CosmeticsTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Tiles -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding CosmeticTiles}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Tile" Width="122" Height="158" Margin="0,0,8,8" Cursor="Hand" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.CosmeticTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Frame" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Background="#1A2A6CC9">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border CornerRadius="6,6,0,0" ClipToBounds="True">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Offset="0" Color="#FF3A7BD5" />
                                                                <GradientStop Offset="1" Color="#FF1B3E78" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Type}" FontSize="9" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Row="1" Margin="6,4,6,5">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PriceText}" FontSize="9.5" Foreground="#8A8A8A" />
                                                            <TextBlock Text="{Binding Type}" FontSize="9.5" Foreground="#8A8A8A" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                    <Border x:Name="Owned" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Width="20" Height="20"
                                                            CornerRadius="10" Background="#2ECC71" Visibility="Collapsed">
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border x:Name="Picked" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0" Padding="5,1"
                                                            CornerRadius="2" Background="#F4EC17" Visibility="Collapsed">
                                                        <TextBlock Text="{Binding Pick}" FontSize="8.5" FontWeight="Bold" Foreground="#13233D" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="#99FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="#99FFFFFF" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                    <Setter TargetName="Owned" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="#2ECC71" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                    <Setter TargetName="Picked" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PlayFillBrush}" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsOwned}" Value="False" />
                                                        <Condition Binding="{Binding DataContext.CosmeticsLockerMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GhostButton}" Height="34" Padding="18,0" Margin="0,6,0,0" HorizontalAlignment="Center"
                            Content="Show more" FontWeight="Bold" Command="{Binding CosmeticsMoreCommand}"
                            Visibility="{Binding CosmeticsHasMore, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding CosmeticsLockerMode, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Margin="8,0,0,0" FontSize="11" FontWeight="Bold"
                            Content="Add all shown" Command="{Binding LockerAddShownCommand}"
                            ToolTip="Add every item that matches the type and search to the locker" />
                    <Button Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Margin="8,0,0,0" FontSize="11" FontWeight="Bold"
                            Content="Remove all shown" Command="{Binding LockerRemoveShownCommand}"
                            ToolTip="Take every item that matches the type and search out of the locker (default items stay)" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CosmeticsCount}" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{Binding CosmeticsNote}" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
