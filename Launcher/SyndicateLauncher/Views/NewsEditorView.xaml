<UserControl x:Class="SyndicateLauncher.Views.NewsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" KeyDown="OnKeyDown" IsVisibleChanged="OnIsVisibleChanged">
    <!-- News & tournaments editor (ViewModels/MainViewModel.News.cs): posts for the game's News tab and tournaments for
         the Compete tab (8.50 to 12.50). DataContext is MainViewModel. -->
    <Border CornerRadius="16" Background="{DynamicResource Tint_F2161616}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
        <Grid Margin="24,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="NEWS &amp; TOURNAMENTS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="In-game news" FontFamily="{StaticResource BurbankFont}" FontSize="40"
                               Foreground="{DynamicResource TextBrush}" Margin="0,-2,0,-6" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" Height="34" VerticalAlignment="Center"
                        Command="{Binding CloseNewsEditorCommand}" ToolTip="Save and close (Esc)" AutomationProperties.Name="Close">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="34" Padding="16,0" Margin="0,0,10,0" FontWeight="Bold"
                        VerticalAlignment="Center" Command="{Binding SaveNewsCommand}" AutomationProperties.Name="Save">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Save" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="34" Padding="14,0" Margin="0,0,10,0"
                        VerticalAlignment="Center" Command="{Binding AddTournamentCommand}" AutomationProperties.Name="Add a tournament">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Tournament" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="34" Padding="14,0" Margin="0,0,10,0"
                        VerticalAlignment="Center" Command="{Binding AddNewsPostCommand}" AutomationProperties.Name="Add a news post">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="News post" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Everything you made -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="NEWS POSTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="None yet. Press + News post." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewsPosts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding NewsPosts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="NewsEntries" Height="44" Margin="0,0,0,6"
                                                 CommandParameter="{Binding}" AutomationProperties.Name="{Binding Heading}"
                                                 Command="{Binding DataContext.SelectNewsEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="{Binding Heading}" FontSize="12" Width="240" TextTrimming="CharacterEllipsis" />
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="TOURNAMENTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,6" />
                        <TextBlock Text="None yet. Press + Tournament." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewsTournaments.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding NewsTournaments}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="NewsEntries" Height="44" Margin="0,0,0,6"
                                                 CommandParameter="{Binding}" AutomationProperties.Name="{Binding Heading}"
                                                 Command="{Binding DataContext.SelectNewsEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="{Binding Heading}" FontSize="12" Width="240" TextTrimming="CharacterEllipsis" />
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,16,0,0"
                                   Text="News posts show in the game's News tab. Tournaments show in the Compete tab on Seasons 8 to X and Chapter 2, and in the News tab of every season when 'Also post in News' is on." />
                    </StackPanel>
                </ScrollViewer>

                <!-- The selected post or tournament -->
                <TextBlock Grid.Column="2" Text="Make a news post or a tournament with the buttons above."
                           FontSize="13" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedNewsEntry}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                              Visibility="{Binding HasSelectedNewsEntry, Converter={StaticResource BoolToVis}}">
                    <Grid DataContext="{Binding SelectedNewsEntry}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />

                            <TextBlock Text="Title" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource GlassTextBox}" Height="34" FontSize="13" MaxLength="40"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Title" />

                            <StackPanel Visibility="{Binding IsTournament, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Second title line (optional)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,4" />
                                <TextBox Style="{StaticResource GlassTextBox}" Height="34" FontSize="13" MaxLength="40"
                                         Text="{Binding Subtitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Second title line" />
                            </StackPanel>

                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Text" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTournament}" Value="True">
                                                <Setter Property="Text" Value="Description and rules" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Style="{StaticResource GlassTextBox}" Height="120" FontSize="12.5" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="1200"
                                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Text" />

                            <TextBlock Text="Season" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,4" />
                            <ComboBox Style="{StaticResource DarkComboBox}" Height="34" FontSize="12"
                                      ItemsSource="{Binding DataContext.NewsSeasonOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding DataContext.SelectedNewsSeason, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                      AutomationProperties.Name="Season" />

                            <!-- Tournament only -->
                            <StackPanel Visibility="{Binding IsTournament, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Mode" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,4" />
                                <ComboBox Style="{StaticResource DarkComboBox}" Height="34" FontSize="12"
                                          ItemsSource="{Binding DataContext.TournamentModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Mode, Mode=TwoWay}"
                                          AutomationProperties.Name="Mode" />
                                <TextBlock Text="The mode has to be turned on for that season in Game modes, or the tournament stays hidden."
                                           FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Starts (your time)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource GlassTextBox}" Height="34" FontSize="12.5"
                                                 Text="{Binding BeginText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Start time" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ends" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource GlassTextBox}" Height="34" FontSize="12.5"
                                                 Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="End time" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding TimeNote}" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                <TextBlock Text="Schedule line on the poster" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,4" />
                                <TextBox Style="{StaticResource GlassTextBox}" Height="34" FontSize="12.5" MaxLength="80"
                                         Text="{Binding Schedule, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Schedule line" />

                                <TextBlock Text="Poster colour" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,4" />
                                <ItemsControl ItemsSource="{Binding DataContext.TournamentColors, RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.NewsColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="15" Background="{Binding Swatch}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="2" />
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,8,0,0" IsChecked="{Binding PostInNews, Mode=TwoWay}"
                                          Content="Also post it in the News tab" AutomationProperties.Name="Also post in the News tab" />
                            </StackPanel>

                            <Button Style="{StaticResource GhostButton}" Height="34" Padding="14,0" Margin="0,18,0,0" HorizontalAlignment="Left"
                                    Command="{Binding DataContext.DeleteNewsEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.Name="Delete">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="Delete" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Picture and a rough preview of the post -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PICTURE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                            <Border CornerRadius="10" Height="146" Background="#12FFFFFF" BorderBrush="{DynamicResource HairlineBrush}"
                                    BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="No picture" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource GhostButton}" Height="32" Padding="12,0"
                                        Command="{Binding DataContext.ChooseNewsImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Content="Choose picture" FontSize="11" AutomationProperties.Name="Choose a picture" />
                                <Button Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Margin="8,0,0,0"
                                        Command="{Binding DataContext.ClearNewsImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Content="Remove" FontSize="11" AutomationProperties.Name="Remove the picture"
                                        Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Text="A wide picture (16:9, about 1024 x 512) looks best in the News tab and on the tournament poster."
                                       FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

                            <TextBlock Text="PREVIEW" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,18,0,8" />
                            <Border CornerRadius="10" Padding="14,12" Background="#12FFFFFF" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontFamily="{StaticResource BurbankFont}" FontSize="24"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource BurbankFont}" FontSize="18"
                                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding IsTournament, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Schedule}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding IsTournament, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Body}" FontSize="11.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                               Margin="0,6,0,0" MaxHeight="160" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding NewsNote}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </Grid>
    </Border>
</UserControl>
