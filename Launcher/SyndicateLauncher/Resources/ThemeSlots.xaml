<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme slots. Every key here is recoloured at runtime by Services/ThemeService.cs from the
         active theme (Themes tab). The key encodes the original Syndicate colour:
           Accent_AA          the accent at alpha AA (was #AAF2F3F5)
           Tint_AARRGGBB      a neutral dark surface, re-tinted to the theme (brush)
           TintColor_AARRGGBB the same as a Color, for gradient stops
         These defaults are the Syndicate look. Use {DynamicResource ...} for them, never StaticResource. -->
