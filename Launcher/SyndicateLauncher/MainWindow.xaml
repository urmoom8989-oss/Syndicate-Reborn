                        <!-- ======================= PATCH NOTES PAGE ======================= -->
                        <!-- Text lives in Models/PatchNotes.cs, tabs in ViewModels/MainViewModel.PatchNotes.cs.
                             Opens once by itself after an update. -->
                        <Grid Grid.Row="0" Grid.RowSpan="5"
                              Visibility="{Binding IsPatchNotesScreen, Converter={StaticResource BoolToVis}}"
                              AutomationProperties.Name="Patch notes">
                            <Grid.Resources>
                                <Style x:Key="PatchCard" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Tint_FF161616}" />
                                    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="12" />
                                    <Setter Property="Padding" Value="20,16" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                </Style>
                                <!-- Version / category chip: label + small count, white when selected. -->
                                <Style x:Key="PatchChip" TargetType="RadioButton">
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Foreground" Value="#CFCFCF" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Bd" CornerRadius="15" Padding="13,0" Background="#10FFFFFF"
                                                        BorderBrush="#24FFFFFF" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                        <Border x:Name="Count" CornerRadius="7" Padding="6,1" Margin="7,0,0,0"
                                                                Background="#1FFFFFFF" VerticalAlignment="Center"
                                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock x:Name="CountText" Text="{Binding Badge}" FontSize="8.5" FontWeight="Bold"
                                                                       Foreground="#BDBDBD" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                        <Setter TargetName="Count" Property="Background" Value="#22000000" />
                                                        <Setter TargetName="CountText" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <!-- One line of a section. -->
                                <DataTemplate x:Key="PatchItemTemplate">
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="5" Height="5" Margin="1,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 Fill="{DynamicResource AccentBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11.5" Foreground="#D9D9D9"
                                                   TextWrapping="Wrap" LineHeight="17" />
                                    </Grid>
                                </DataTemplate>
                            </Grid.Resources>
                            <!-- Solid page: the launcher's animated stars must not show through the text. -->
                            <Border CornerRadius="12" BorderBrush="#24FFFFFF" BorderThickness="1" ClipToBounds="True"
                                    Background="{DynamicResource Tint_FF0C0C0C}">
                                <Grid>
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="Assets/ice-bg.jpg" Stretch="UniformToFill" Opacity="0.18" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource TintColor_F2101010}" Offset="0" />
                                                <GradientStop Color="{DynamicResource TintColor_E6131313}" Offset="0.52" />
                                                <GradientStop Color="{DynamicResource TintColor_F50C0C0C}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <ScrollViewer x:Name="PatchNotesScroll" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                        <StackPanel Margin="36,24,32,28" MaxWidth="1100" HorizontalAlignment="Stretch">
                                            <!-- Title + back -->
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="26" Height="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="WHAT'S NEW IN SYNDICATE" FontSize="7.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentSoftBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="PATCH NOTES" FontFamily="{StaticResource BurbankFont}" FontSize="58"
                                                               FontWeight="Bold" FontStretch="Condensed" Foreground="#FFFFFF"
                                                               LineHeight="58" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Button Style="{StaticResource GhostButton}" Height="32" Padding="14,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Command="{Binding HomeCommand}" AutomationProperties.Name="Back to home">
                                                    <TextBlock Text="BACK HOME" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>

                                            <!-- Version tabs -->
                                            <ItemsControl ItemsSource="{Binding PatchVersionTabs}" Margin="0,12,0,4">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton Style="{StaticResource PatchChip}" GroupName="PatchVersion"
                                                                     IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                                     AutomationProperties.Name="{Binding Label}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Release summary -->
                                            <Border Style="{StaticResource PatchCard}" Padding="22,18" Margin="0,4,0,12"
                                                    Background="{DynamicResource Tint_E6181818}" BorderBrush="{DynamicResource Accent_2E}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                                        <TextBlock FontSize="9.5" FontWeight="Bold" Foreground="#A8A8A8">
                                                            <Run Text="{Binding SelectedPatch.VersionLabel, Mode=OneWay}" Foreground="{DynamicResource AccentSoftBrush}" />
                                                            <Run Text="  /  " />
                                                            <Run Text="{Binding SelectedPatch.Date, Mode=OneWay}" />
                                                            <Run Text="  /  " />
                                                            <Run Text="{Binding SelectedPatch.ChangeCountText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding SelectedPatch.Title}" FontFamily="{StaticResource BurbankFont}"
                                                                   FontSize="34" FontWeight="Bold" FontStretch="Condensed" Foreground="#FFFFFF"
                                                                   LineHeight="36" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding SelectedPatch.Summary}" FontSize="11.5" Foreground="#CECECE"
                                                                   TextWrapping="Wrap" LineHeight="18" MaxWidth="860" HorizontalAlignment="Left"
                                                                   Margin="0,4,0,0" />
                                                        <!-- Highlights: numbered, two per row -->
                                                        <ItemsControl ItemsSource="{Binding SelectedPatch.NumberedHighlights}" Margin="0,14,0,-8">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,18,10">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="34" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Number}" FontFamily="{StaticResource BurbankFont}"
                                                                                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                                                   Opacity="0.9" VerticalAlignment="Top" />
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}"
                                                                                       FontSize="14" FontWeight="Bold" FontStyle="Italic" Foreground="#FFFFFF" />
                                                                            <TextBlock Text="{Binding Text}" FontSize="10.5" Foreground="#B5B5B5"
                                                                                       TextWrapping="Wrap" LineHeight="15" Margin="0,2,0,0" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Known issues: one small amber bar -->
                                            <Border CornerRadius="10" Padding="14,9" Margin="0,0,0,12" Background="#14FFB547"
                                                    BorderBrush="#40FFB547" BorderThickness="1"
                                                    Visibility="{Binding ShowPatchKnownIssues, Converter={StaticResource BoolToVis}}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="KNOWN ISSUE" FontSize="9" FontWeight="Bold"
                                                               Foreground="#FFB547" Margin="0,1,12,0" VerticalAlignment="Top" />
                                                    <ItemsControl ItemsSource="{Binding SelectedPatch.KnownIssues}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#E8D2B0" TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>
                                            </Border>

                                            <!-- Category tabs -->
                                            <ItemsControl ItemsSource="{Binding PatchCategoryTabs}" Margin="0,0,0,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton Style="{StaticResource PatchChip}" GroupName="PatchCategory"
                                                                     IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                                     AutomationProperties.Name="{Binding Label}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Sections -->
                                            <ItemsControl ItemsSource="{Binding VisiblePatchSections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource PatchCard}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="170" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}"
                                                                               FontSize="16" FontWeight="Bold" FontStyle="Italic"
                                                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                                    <Border Width="22" Height="2" Background="{DynamicResource AccentBrush}"
                                                                            HorizontalAlignment="Left" Margin="1,5,0,0" Opacity="0.85" />
                                                                </StackPanel>
                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}"
                                                                              ItemTemplate="{StaticResource PatchItemTemplate}" Margin="0,1,0,-7" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ======================= SETTINGS PAGE ======================= -->
                        <Grid x:Name="SettingsRoot" Grid.Row="0" Grid.RowSpan="5"
                              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                            <Border Background="{DynamicResource Tint_C4080808}" CornerRadius="12">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseSettingsCommand}" />
                                </Border.InputBindings>
                            </Border>

                            <!-- The sheet's shadow, on its own cached backing panel that slides with the sheet. With the
                                 shadow effect on the sheet itself, every frame anything moved (wallpaper drift, glow,
                                 particles, a hover) re-rendered the whole Settings page through a 40 px blur. -->
                            <Border Margin="12" CornerRadius="16" Background="{DynamicResource Tint_FF0D0D0D}"
                                    IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                                    RenderTransform="{Binding RenderTransform, ElementName=SettingsSheet}"
                                    Opacity="{Binding Opacity, ElementName=SettingsSheet}">
                                <Border.CacheMode>
                                    <BitmapCache EnableClearType="False" />
                                </Border.CacheMode>
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="10" Opacity="0.55" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="SettingsSheet" Margin="12" CornerRadius="16"
                                    Background="{DynamicResource Tint_F20D0D0D}" BorderBrush="#26FFFFFF" BorderThickness="1"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="SettingsSlide" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.Resources>
                                        <Style x:Key="ThemesSectionLabel" TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                                            <Setter Property="FontSize" Value="17" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                        <Style x:Key="ThemesHint" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="10.5" />
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="LineHeight" Value="15" />
                                        </Style>
                                        <Style x:Key="ThemesFieldLabel" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12.5" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        </Style>
                                        <Style x:Key="ThemesValue" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>

                                        <!-- A theme card: lifts on hover, shows its actions, and pops a check when picked. -->
                                        <Style x:Key="ThemeCardButton" TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Margin" Value="0,0,12,12" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform x:Name="Press" />
                                                                    <TranslateTransform x:Name="Lift" />
                                                                </TransformGroup>
                                                            </Grid.RenderTransform>
                                                            <!-- BitmapCache: the blur is drawn once and reused. Without it, the ~35 cards on the
                                                                 Themes page re-ran their shadow blur on every frame the backdrop, wallpaper or
                                                                 particles moved behind them (the stutter on that page). -->
                                                            <Border x:Name="Shadow" CornerRadius="13" Background="#01000000" Opacity="0.25">
                                                                <Border.CacheMode>
                                                                    <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                                                                </Border.CacheMode>
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="6" Color="Black" Opacity="0.8" />
                                                                </Border.Effect>
                                                            </Border>
                                                            <ContentPresenter />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                                                             To="-4" Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                                                                             To="0.85" Duration="0:0:0.18" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                                                             To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                                                                             To="0.25" Duration="0:0:0.22" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                            <!-- A Setter cannot target a transform inside RenderTransform (MC4111); animate it instead. -->
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.975" Duration="0:0:0.06" />
                                                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.975" Duration="0:0:0.06" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1" />
                                                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <Style x:Key="ThemeIconButton" TargetType="Button">
                                            <Setter Property="Width" Value="24" />
                                            <Setter Property="Height" Value="24" />
                                            <Setter Property="Margin" Value="4,0,0,0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                            <Setter Property="FontSize" Value="10" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="12" Background="#B3000000"
                                                                BorderBrush="#33FFFFFF" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <Style x:Key="SwatchButton" TargetType="Button">
                                            <Setter Property="Width" Value="20" />
                                            <Setter Property="Height" Value="20" />
                                            <Setter Property="Margin" Value="0,0,6,6" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <ScaleTransform x:Name="Grow" />
                                                            </Grid.RenderTransform>
                                                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0:0:0.12" />
                                                                            <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.12" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                                                            <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- Hue slider: a rainbow track with the usual thumb. -->
                                        <Style x:Key="HueSlider" TargetType="Slider">
                                            <Setter Property="Minimum" Value="0" />
                                            <Setter Property="Maximum" Value="360" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Slider">
                                                        <Grid Height="24" Background="Transparent">
                                                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#FF0000" Offset="0" />
                                                                        <GradientStop Color="#FFFF00" Offset="0.167" />
                                                                        <GradientStop Color="#00FF00" Offset="0.333" />
                                                                        <GradientStop Color="#00FFFF" Offset="0.5" />
                                                                        <GradientStop Color="#0000FF" Offset="0.667" />
                                                                        <GradientStop Color="#FF00FF" Offset="0.833" />
                                                                        <GradientStop Color="#FF0000" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <Track x:Name="PART_Track">
                                                                <Track.DecreaseRepeatButton>
                                                                    <RepeatButton Style="{StaticResource SliderEmpty}" Command="Slider.DecreaseLarge" />
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.IncreaseRepeatButton>
                                                                    <RepeatButton Style="{StaticResource SliderEmpty}" Command="Slider.IncreaseLarge" />
                                                                </Track.IncreaseRepeatButton>
                                                                <Track.Thumb>
                                                                    <Thumb Style="{StaticResource IceThumb}" />
                                                                </Track.Thumb>
                                                            </Track>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- The little launcher drawn inside every theme card. -->
                                        <DataTemplate x:Key="ThemeMock">
                                            <Border CornerRadius="9" Background="{Binding PreviewBrush}" ClipToBounds="True"
                                                    BorderBrush="#1AFFFFFF" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.22*" />
                                                        <ColumnDefinition Width="0.78*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{Binding SidebarBrush}" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
                                                        <StackPanel Margin="7,9,7,0">
                                                            <Border Width="10" Height="10" CornerRadius="3" HorizontalAlignment="Left"
                                                                    Background="{Binding AccentBrush}" />
                                                            <Border Height="3" CornerRadius="1.5" Background="{Binding AccentBrush}" Margin="0,10,3,0" />
                                                            <Border Height="3" CornerRadius="1.5" Background="{Binding MutedBrush}" Margin="0,5,6,0" Opacity="0.7" />
                                                            <Border Height="3" CornerRadius="1.5" Background="{Binding MutedBrush}" Margin="0,5,2,0" Opacity="0.7" />
                                                            <Border Height="3" CornerRadius="1.5" Background="{Binding MutedBrush}" Margin="0,5,5,0" Opacity="0.7" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Grid Grid.Column="1" Margin="9,9,9,8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel>
                                                            <Border Width="38" Height="5" CornerRadius="2.5" HorizontalAlignment="Left"
                                                                    Background="{Binding TextBrush}" />
                                                            <Border Width="24" Height="3" CornerRadius="1.5" HorizontalAlignment="Left"
                                                                    Background="{Binding AccentBrush}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <Border Grid.Row="1" CornerRadius="5" Background="{Binding SurfaceBrush}"
                                                                BorderBrush="#14FFFFFF" BorderThickness="1" Margin="0,7,0,7">
                                                            <Border Width="22" Height="3" CornerRadius="1.5" Background="{Binding MutedBrush}"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" />
                                                        </Border>
                                                        <Grid Grid.Row="2">
                                                            <Border Width="40" Height="11" CornerRadius="3" HorizontalAlignment="Left"
                                                                    Background="{Binding LaunchBrush}" />
                                                            <Border Width="22" Height="11" CornerRadius="3" HorizontalAlignment="Left"
                                                                    Margin="45,0,0,0" Background="{Binding SurfaceBrush}"
                                                                    BorderBrush="#24FFFFFF" BorderThickness="1" />
                                                        </Grid>
                                                    </Grid>
                                                    <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom"
                                                            Background="{Binding StripeBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>

                                        <DataTemplate x:Key="ThemeCard">
                                            <Button Style="{StaticResource ThemeCardButton}"
                                                    Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Description}"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <Border x:Name="CardFrame" CornerRadius="13" Background="{Binding SurfaceBrush}"
                                                            BorderBrush="#24FFFFFF" BorderThickness="1" Padding="6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ThemeMock}"
                                                                            IsTabStop="False" Focusable="False" />
                                                            <Grid Grid.Row="1" Margin="4,8,4,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                                                               Foreground="{Binding TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Description}" FontSize="9.5" Margin="0,2,0,0"
                                                                               Foreground="{Binding MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,3,0,0">
                                                                    <Ellipse Width="9" Height="9" Fill="{Binding AccentBrush}" />
                                                                    <Ellipse Width="9" Height="9" Fill="{Binding Accent2Brush}" Margin="-3,0,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Selected ring -->
                                                    <Border x:Name="Ring" CornerRadius="13" BorderBrush="{Binding AccentBrush}"
                                                            BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
                                                    <!-- Check badge -->
                                                    <Grid x:Name="Check" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                          Margin="12,12,0,0" RenderTransformOrigin="0.5,0.5" Opacity="0" IsHitTestVisible="False">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform x:Name="CheckPop" ScaleX="0.4" ScaleY="0.4" />
                                                        </Grid.RenderTransform>
                                                        <Ellipse Fill="{Binding AccentBrush}" Stroke="#66000000" StrokeThickness="1" />
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   Foreground="{Binding OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <!-- Hover actions -->
                                                    <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                VerticalAlignment="Top" Margin="0,12,12,0" Opacity="0">
                                                        <Button Style="{StaticResource ThemeIconButton}" Content="&#xE8C8;"
                                                                ToolTip="Remix: start a new theme from this one"
                                                                Command="{Binding DataContext.DuplicateThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Remix theme" />
                                                        <Button Style="{StaticResource ThemeIconButton}" Content="&#xE70F;"
                                                                ToolTip="Edit this theme"
                                                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.EditThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Edit theme" />
                                                        <Button Style="{StaticResource ThemeIconButton}" Content="&#xE74D;"
                                                                ToolTip="Delete this theme"
                                                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.DeleteThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Delete theme" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Check" Property="Opacity" Value="1" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="CheckPop" Storyboard.TargetProperty="ScaleX"
                                                                                 From="0.4" To="1" Duration="0:0:0.32">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="CheckPop" Storyboard.TargetProperty="ScaleY"
                                                                                 From="0.4" To="1" Duration="0:0:0.32">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                                <Trigger SourceName="CardFrame" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    <Setter TargetName="CardFrame" Property="BorderBrush" Value="#55FFFFFF" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>

                                        <!-- Fortnite Lobby Theme card: the lobby art fills the card, the name sits on it in Burbank like
                                             the Fortnite lobby. Hover zooms the art and runs a light sweep across it; the picked one
                                             gets the yellow Fortnite ring and a check. -->
                                        <DataTemplate x:Key="LobbyThemeCard">
                                            <Button Style="{StaticResource ThemeCardButton}"
                                                    Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Description}"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <Border x:Name="Art" CornerRadius="13" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill">
                                                                <ImageBrush.RelativeTransform>
                                                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                                                </ImageBrush.RelativeTransform>
                                                            </ImageBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- Light sweep (runs on hover) -->
                                                    <Grid ClipToBounds="True" Margin="1" IsHitTestVisible="False">
                                                        <Rectangle x:Name="Sweep" Width="70" HorizontalAlignment="Left" Opacity="0"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                                    <GradientStop Color="#55FFFFFF" Offset="0.5" />
                                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                            <Rectangle.RenderTransform>
                                                                <TransformGroup>
                                                                    <SkewTransform AngleX="-18" />
                                                                    <TranslateTransform x:Name="SweepMove" X="-120" />
                                                                </TransformGroup>
                                                            </Rectangle.RenderTransform>
                                                        </Rectangle>
                                                    </Grid>
                                                    <!-- Shade under the name -->
                                                    <Border CornerRadius="0,0,13,13" VerticalAlignment="Bottom" Height="72" Margin="1" IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0" />
                                                                <GradientStop Color="#99000000" Offset="0.55" />
                                                                <GradientStop Color="#E0000000" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,11" IsHitTestVisible="False">
                                                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="#FFE15A" Padding="6,1,6,0">
                                                            <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource BurbankFont}" FontSize="11"
                                                                       Foreground="#14161A" />
                                                        </Border>
                                                        <!-- The shadow is a second copy of the title, 1.5 px lower in black: looks the same as a
                                                             drop shadow effect and costs nothing when things move behind the card. -->
                                                        <Grid Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource BurbankFont}" FontSize="21"
                                                                       Foreground="#C0000000" Margin="1,1.5,0,0" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource BurbankFont}" FontSize="21"
                                                                       Foreground="White" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <Border Height="3" VerticalAlignment="Bottom" Margin="14,0,14,1" CornerRadius="2"
                                                            Background="{Binding StripeBrush}" IsHitTestVisible="False" />
                                                    <!-- Selected ring (Fortnite yellow) with a soft outer glow made of two faint rings
                                                         instead of a glow effect. -->
                                                    <Grid x:Name="Ring" Opacity="0" IsHitTestVisible="False">
                                                        <Border CornerRadius="17" Margin="-4" BorderBrush="#26FFE15A" BorderThickness="2" />
                                                        <Border CornerRadius="15" Margin="-2" BorderBrush="#4DFFE15A" BorderThickness="2" />
                                                        <Border CornerRadius="13" BorderBrush="#FFE15A" BorderThickness="2.5" />
                                                    </Grid>
                                                    <!-- Check badge -->
                                                    <Grid x:Name="Check" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                          Margin="10,10,0,0" RenderTransformOrigin="0.5,0.5" Opacity="0" IsHitTestVisible="False">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform x:Name="CheckPop" ScaleX="0.4" ScaleY="0.4" />
                                                        </Grid.RenderTransform>
                                                        <Ellipse Fill="#FFE15A" Stroke="#66000000" StrokeThickness="1" />
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   Foreground="#14161A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <!-- Hover action -->
                                                    <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                VerticalAlignment="Top" Margin="0,10,10,0" Opacity="0">
                                                        <Button Style="{StaticResource ThemeIconButton}" Content="&#xE8C8;"
                                                                ToolTip="Remix: start a new colour theme from this one"
                                                                Command="{Binding DataContext.DuplicateThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Remix theme" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Check" Property="Opacity" Value="1" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="CheckPop" Storyboard.TargetProperty="ScaleX"
                                                                                 From="0.4" To="1" Duration="0:0:0.32">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="CheckPop" Storyboard.TargetProperty="ScaleY"
                                                                                 From="0.4" To="1" Duration="0:0:0.32">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                                <Trigger SourceName="Art" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Art" Property="BorderBrush" Value="#77FFFFFF" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Art"
                                                                                 Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(ScaleTransform.ScaleX)"
                                                                                 To="1.09" Duration="0:0:0.45">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="Art"
                                                                                 Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(ScaleTransform.ScaleY)"
                                                                                 To="1.09" Duration="0:0:0.45">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity"
                                                                                 From="0" To="1" Duration="0:0:0.12" />
                                                                <DoubleAnimation Storyboard.TargetName="SweepMove" Storyboard.TargetProperty="X"
                                                                                 From="-120" To="460" Duration="0:0:0.75">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseInOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Art"
                                                                                 Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(ScaleTransform.ScaleX)"
                                                                                 To="1" Duration="0:0:0.35">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="Art"
                                                                                 Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(ScaleTransform.ScaleY)"
                                                                                 To="1" Duration="0:0:0.35">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>

                                        <ItemsPanelTemplate x:Key="ThreeAcross">
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                        <ItemsPanelTemplate x:Key="FourAcross">
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                        <ItemsPanelTemplate x:Key="ChipWrap">
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="292" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Sidebar -->
                                    <Border Background="{DynamicResource Tint_D90A0A0A}" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0"
                                            CornerRadius="16,0,0,16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Margin="24,26,24,18">
                                                <TextBlock Text="MAKE IT YOURS" FontSize="7.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentSoftBrush}" />
                                                <TextBlock Text="SETTINGS" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="34" FontWeight="Bold" FontStyle="Italic"
                                                           Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="12,0,12,12">
                                                    <RadioButton x:Name="NavMatch" GroupName="SettingsPage" Tag="0"
                                                                 Style="{StaticResource SettingsNavItem}" IsChecked="True"
                                                                 Checked="SettingsNav_Checked">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="01" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="#8A8A8A" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="Match &amp; bots" FontSize="13" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Bots, difficulty and names" FontSize="10.5" Foreground="#8A8A8A" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="&#xE7FC;"
                                                                       FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                       Foreground="#8A8A8A" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </RadioButton>

                                                    <RadioButton x:Name="NavMods" GroupName="SettingsPage" Tag="1"
                                                                 Style="{StaticResource SettingsNavItem}" Checked="SettingsNav_Checked">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="02" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="#8A8A8A" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="Mods" FontSize="13" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Gameplay extras" FontSize="10.5" Foreground="#8A8A8A" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="&#xE945;"
                                                                       FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                       Foreground="#8A8A8A" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </RadioButton>

                                                    <RadioButton x:Name="NavDisplay" GroupName="SettingsPage" Tag="2"
                                                                 Style="{StaticResource SettingsNavItem}" Checked="SettingsNav_Checked">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="03" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="#8A8A8A" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="Display" FontSize="13" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Crosshair, FOV and stretch" FontSize="10.5" Foreground="#8A8A8A" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="&#xE7F4;"
                                                                       FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                       Foreground="#8A8A8A" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </RadioButton>

                                                    <RadioButton x:Name="NavFiles" GroupName="SettingsPage" Tag="3"
                                                                 Style="{StaticResource SettingsNavItem}" Checked="SettingsNav_Checked">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="04" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="#8A8A8A" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="Launcher &amp; files" FontSize="13" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Folders and version" FontSize="10.5" Foreground="#8A8A8A" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="&#xE8B7;"
                                                                       FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                       Foreground="#8A8A8A" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </RadioButton>
                                                    <RadioButton x:Name="NavThemes" GroupName="SettingsPage" Tag="4"
                                                                 Style="{StaticResource SettingsNavItem}" Checked="SettingsNav_Checked">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="05" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="#8A8A8A" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="Themes" FontSize="13" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Colours, custom themes, effects" FontSize="10.5" Foreground="#8A8A8A" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="&#xE790;"
                                                                       FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                       Foreground="#8A8A8A" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </RadioButton>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <TextBlock Grid.Row="2" Text="{Binding SettingsVersionLine}"
                                                       FontSize="10" Foreground="#6E6E6E" Margin="24,8,22,18"
                                                       LineHeight="16" />
                                        </Grid>
                                    </Border>

                                    <!-- Content -->
                                    <Grid Grid.Column="1" Margin="32,24,24,20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock x:Name="SettingsPageIndex" Text="01  /  04" FontSize="10"
                                                           FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock x:Name="SettingsPageTitle" Text="MATCH &amp; BOTS"
                                                           FontFamily="{StaticResource DisplayFont}" FontSize="42"
                                                           FontWeight="Bold" FontStyle="Italic"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           LineHeight="40" Margin="0,2,0,0" />
                                                <TextBlock x:Name="SettingsPageDetail" FontSize="12" Foreground="#A8A8A8"
                                                           TextWrapping="Wrap" MaxWidth="720" Margin="0,6,0,0"
                                                           LineHeight="17" />
                                            </StackPanel>
                                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" Command="{Binding CloseSettingsCommand}"
                                                    ToolTip="Close settings (Esc)"
                                                    AutomationProperties.Name="Close settings">
                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                            </Button>
                                        </Grid>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      PanningMode="VerticalOnly">
                                            <Grid>
                                                <!-- 01 Match & bots -->
                                                <Border x:Name="SettingsPageMatch" Style="{StaticResource SettingsCard}">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBox Style="{StaticResource GlassTextBox}" Width="110"
                                                                     DockPanel.Dock="Right"
                                                                     Text="{Binding BotCountRange, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="Number of bots" />
                                                            <TextBlock Text="Number of bots" FontSize="13.5"
                                                                       FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <TextBlock Text="Enter a number or range, such as 40-60. Leave blank for 99 bots. Matches are capped at 100 players."
                                                                   FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                   Margin="0,8,0,6" />
                                                        <TextBlock Text="{Binding BotCountError}" FontSize="10"
                                                                   Foreground="{DynamicResource DangerBrush}"
                                                                   TextWrapping="Wrap" Margin="0,0,0,12" />

                                                        <TextBlock Text="Difficulty" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />
                                                        <UniformGrid Columns="5" Margin="0,10,0,10">
                                                            <RadioButton Style="{StaticResource ChipRadio}" Content="Bot"
                                                                         GroupName="DifficultyChip"
                                                                         IsChecked="{Binding DifficultyIndex, Converter={StaticResource IntEquals}, ConverterParameter=0, Mode=OneWay}"
                                                                         Command="{Binding SetDifficultyCommand}" CommandParameter="0" />
                                                            <RadioButton Style="{StaticResource ChipRadio}" Content="Easy"
                                                                         GroupName="DifficultyChip"
                                                                         IsChecked="{Binding DifficultyIndex, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=OneWay}"
                                                                         Command="{Binding SetDifficultyCommand}" CommandParameter="1" />
                                                            <RadioButton Style="{StaticResource ChipRadio}" Content="Medium"
                                                                         GroupName="DifficultyChip"
                                                                         IsChecked="{Binding DifficultyIndex, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=OneWay}"
                                                                         Command="{Binding SetDifficultyCommand}" CommandParameter="2" />
                                                            <RadioButton Style="{StaticResource ChipRadio}" Content="Hard"
                                                                         GroupName="DifficultyChip"
                                                                         IsChecked="{Binding DifficultyIndex, Converter={StaticResource IntEquals}, ConverterParameter=3, Mode=OneWay}"
                                                                         Command="{Binding SetDifficultyCommand}" CommandParameter="3" />
                                                            <RadioButton Style="{StaticResource ChipRadio}" Content="Variety"
                                                                         GroupName="DifficultyChip"
                                                                         IsChecked="{Binding DifficultyIndex, Converter={StaticResource IntEquals}, ConverterParameter=5, Mode=OneWay}"
                                                                         Command="{Binding SetDifficultyCommand}" CommandParameter="5" />
                                                        </UniformGrid>
                                                        <TextBlock Text="{Binding DifficultyDescription}" FontSize="11.5"
                                                                   Foreground="#8A8A8A" TextWrapping="Wrap" LineHeight="17" />

                                                        <TextBlock Text="Bot names" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" Margin="0,22,0,0" />
                                                        <TextBlock Text="Every bot gets a random name, new every match. Add your own names below (one per line): each one is given to a random bot in every match."
                                                                   FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                   Margin="0,4,0,9" />
                                                        <TextBlock Text="Your bot names" FontSize="11" FontWeight="Bold" Foreground="#9A9A9A" Margin="0,0,0,5" />
                                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <TextBox Style="{StaticResource GlassTextBox}" MinHeight="70" FontSize="12"
                                                                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                                                     Text="{Binding CustomBotNamesText, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="Your bot names, one per line" />
                                                        </ScrollViewer>
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding CustomBotNamesSummary}" FontSize="10.5" Foreground="#8A8A8A"
                                                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="30" Padding="14,0"
                                                                    Content="Save names" FontSize="11" FontWeight="Bold"
                                                                    Command="{Binding SaveCustomBotNamesCommand}"
                                                                    IsEnabled="{Binding CustomBotNamesDirty}"
                                                                    AutomationProperties.Name="Save your bot names" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding CustomBotNamesError}" FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   Visibility="{Binding HasCustomBotNamesError, Converter={StaticResource BoolToVis}}" />
                                                        <Expander Style="{StaticResource DarkExpander}" Margin="0,12,0,0">
                                                            <Expander.Header>
                                                                <TextBlock Text="{Binding BotNamePoolHeader}" FontSize="11.5" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}" />
                                                            </Expander.Header>
                                                            <StackPanel Margin="0,8,0,0">
                                                                <TextBox Style="{StaticResource GlassTextBox}" Height="30" Padding="8,3" FontSize="11.5"
                                                                         VerticalContentAlignment="Center"
                                                                         Text="{Binding BotNamePoolSearch, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="Search the names"
                                                                         AutomationProperties.Name="Search the bot name pool" />
                                                                <Border Background="#08000000" BorderBrush="#16FFFFFF" BorderThickness="1"
                                                                        CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
                                                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                                                                  HorizontalScrollBarVisibility="Disabled">
                                                                        <TextBlock Text="{Binding BotNamePoolText}" FontSize="11" LineHeight="18"
                                                                                   Foreground="#B0B0B0" TextWrapping="Wrap" />
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </StackPanel>
                                                        </Expander>

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding HighTickFullLobbies}"
                                                                  AutomationProperties.Name="60 ticks in full lobbies">
                                                            <StackPanel>
                                                                <TextBlock Text="60 ticks in full lobbies" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="The match server updates 60 times a second instead of 30 when there are more than 30 bots. Needs a strong PC; applies from the next match."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding FastQueue}"
                                                                  AutomationProperties.Name="Fast queue">
                                                            <StackPanel>
                                                                <TextBlock Text="Fast queue" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="PLAY starts Fortnite while your match loads, so you can press Ready in the lobby straight away and join the moment the island is ready. While you play a match, your next match loads in the background, so pressing Ready puts you on the warm-up island in seconds, like Season X. Uses about 2-4 GB more memory and is skipped automatically on PCs with too little memory. Applies from the next match."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding LateGame}"
                                                                  AutomationProperties.Name="Late game">
                                                            <StackPanel>
                                                                <TextBlock Text="Late game (Pre-season, Season 2 and Season X)" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Skip the early game: 60 players (you and 59 bots, the bot count above is ignored). The bus flies over the fourth storm circle and everyone lands in it with a shotgun, AR, sniper or SMG, heals, full shield and 500 of each material. Pre-season (1.7.2), Season 2 (1.11, 2.5) and Season X only: every other season plays a normal match even with this on. Applies from the next match."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 02 Mods -->
                                                <Border x:Name="SettingsPageMods" Style="{StaticResource SettingsCard}"
                                                        Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="Gameplay mods" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="Extras that change how the game plays. They load with the next match."
                                                                   FontSize="11.5" Foreground="#8A8A8A" Margin="0,4,0,16" />

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Style="{StaticResource SwitchToggle}"
                                                                      IsChecked="{Binding EditOnRelease}"
                                                                      AutomationProperties.Name="Edit on release">
                                                                <StackPanel>
                                                                    <TextBlock Text="Edit on release" FontSize="13.5"
                                                                               FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="Pick your tiles and let go: the edit is confirmed for you. Works on keyboard and controller."
                                                                               FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                               Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                            <Button x:Name="EditOptionsArrow" Grid.Column="1"
                                                                    Style="{StaticResource IconButton}" Width="28" Height="28"
                                                                    Margin="10,0,0,0" VerticalAlignment="Top"
                                                                    Click="EditOptionsToggle_Click"
                                                                    ToolTip="Show edit on release options"
                                                                    AutomationProperties.Name="Show edit on release options">
                                                                <TextBlock x:Name="EditOptionsArrowGlyph" Text="&#xE70D;"
                                                                           FontFamily="{StaticResource IconFont}" FontSize="9" />
                                                            </Button>
                                                        </Grid>


                                                        <Border x:Name="EditOptions" Background="#08FFFFFF" BorderBrush="#14FFFFFF"
                                                                BorderThickness="1" CornerRadius="10" Padding="14"
                                                                Margin="0,12,0,0" Visibility="Collapsed">
                                                            <StackPanel>
                                                                <TextBlock Text="Options" FontSize="11" FontWeight="Bold"
                                                                           Foreground="#9A9A9A" Margin="0,0,0,10" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Edit key" FontSize="11.5"
                                                                           Foreground="#B4B4B4" Margin="0,0,0,6" />
                                                                <ComboBox Style="{StaticResource DarkComboBox}"
                                                                          ItemsSource="{Binding EditKeys}"
                                                                          SelectedItem="{Binding SelectedEditKey, Mode=TwoWay}"
                                                                          AutomationProperties.Name="Edit key">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Name}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Controller edit button" FontSize="11.5"
                                                                           Foreground="#B4B4B4" Margin="0,0,0,6" />
                                                                <ComboBox Style="{StaticResource DarkComboBox}"
                                                                          ItemsSource="{Binding PadEditButtons}"
                                                                          SelectedItem="{Binding PadEditButton, Mode=TwoWay}"
                                                                          AutomationProperties.Name="Controller edit button" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding EditSelectRelease}"
                                                                  AutomationProperties.Name="Confirm when you let go of select">
                                                            <StackPanel>
                                                                <TextBlock Text="Confirm when you let go of select" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Letting go of the left mouse button or right trigger confirms the edit."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding EditReleaseNeedsTile}"
                                                                  AutomationProperties.Name="Only confirm when you picked a tile">
                                                            <StackPanel>
                                                                <TextBlock Text="Only confirm when you picked a tile" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Turn this off to confirm and leave edit mode every time you let go."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                            </StackPanel>
                                                        </Border>

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding EnableMenu}"
                                                                  AutomationProperties.Name="Inject the Syndicate menu">
                                                            <StackPanel>
                                                                <TextBlock Text="Inject the Syndicate menu" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Loads the in-game menu in every season when Fortnite starts. Press Insert in-game to open it. ESP and aim only target bots. While it is on, matches earn no V-Bucks and don't count toward achievements."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding TurboBuild}"
                                                                  AutomationProperties.Name="Turbo build">
                                                            <StackPanel>
                                                                <TextBlock Text="Turbo build" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Hold place in build mode to keep placing walls, floors, stairs and roofs. Guns and the edit tool are never affected."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding ResetOnRelease}"
                                                                  AutomationProperties.Name="Reset on release">
                                                            <StackPanel>
                                                                <TextBlock Text="Reset on release" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Let go of the edit key without picking a tile and the piece snaps back to a full wall."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <Grid Margin="0,18,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Style="{StaticResource SwitchToggle}"
                                                                      IsChecked="{Binding SprintByDefault}"
                                                                      AutomationProperties.Name="Sprint by default">
                                                                <StackPanel>
                                                                    <TextBlock Text="Sprint by default" FontSize="13.5"
                                                                               FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="Moving forward sprints for you on the seasons that never had it. Aiming still slows you down."
                                                                               FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                               Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                            <Button x:Name="SprintOptionsArrow" Grid.Column="1"
                                                                    Style="{StaticResource IconButton}" Width="28" Height="28"
                                                                    Margin="10,0,0,0" VerticalAlignment="Top"
                                                                    Tag="{Binding ElementName=SprintOptions}"
                                                                    Click="ModOptionsToggle_Click"
                                                                    ToolTip="Show sprint options"
                                                                    AutomationProperties.Name="Show sprint by default options">
                                                                <TextBlock x:Name="SprintOptionsArrowGlyph" Text="&#xE70D;"
                                                                           FontFamily="{StaticResource IconFont}" FontSize="9" />
                                                            </Button>
                                                        </Grid>
                                                        <Border x:Name="SprintOptions" Background="#08FFFFFF" BorderBrush="#14FFFFFF"
                                                                BorderThickness="1" CornerRadius="10" Padding="14"
                                                                Margin="0,12,0,0" Visibility="Collapsed">
                                                            <StackPanel>
                                                                <TextBlock Text="Sprint key" FontSize="11.5" Foreground="#B4B4B4"
                                                                           Margin="0,0,0,6" />
                                                                <ComboBox Style="{StaticResource DarkComboBox}" Width="260"
                                                                          HorizontalAlignment="Left"
                                                                          ItemsSource="{Binding EditKeys}"
                                                                          SelectedItem="{Binding SprintKeyChoice, Mode=TwoWay}"
                                                                          AutomationProperties.Name="Sprint key">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Name}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Border>

                                                        <Grid Margin="0,18,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Style="{StaticResource SwitchToggle}"
                                                                      IsChecked="{Binding AutoRun}"
                                                                      AutomationProperties.Name="Auto run">
                                                                <StackPanel>
                                                                    <TextBlock Text="Auto run" FontSize="13.5"
                                                                               FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="Press the key and keep running forward. Press it again, W or S to stop."
                                                                               FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                               Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                            <Button x:Name="AutoRunOptionsArrow" Grid.Column="1"
                                                                    Style="{StaticResource IconButton}" Width="28" Height="28"
                                                                    Margin="10,0,0,0" VerticalAlignment="Top"
                                                                    Tag="{Binding ElementName=AutoRunOptions}"
                                                                    Click="ModOptionsToggle_Click"
                                                                    ToolTip="Show auto run options"
                                                                    AutomationProperties.Name="Show auto run options">
                                                                <TextBlock x:Name="AutoRunOptionsArrowGlyph" Text="&#xE70D;"
                                                                           FontFamily="{StaticResource IconFont}" FontSize="9" />
                                                            </Button>
                                                        </Grid>
                                                        <Border x:Name="AutoRunOptions" Background="#08FFFFFF" BorderBrush="#14FFFFFF"
                                                                BorderThickness="1" CornerRadius="10" Padding="14"
                                                                Margin="0,12,0,0" Visibility="Collapsed">
                                                            <StackPanel>
                                                                <TextBlock Text="Auto run key" FontSize="11.5" Foreground="#B4B4B4"
                                                                           Margin="0,0,0,6" />
                                                                <ComboBox Style="{StaticResource DarkComboBox}" Width="260"
                                                                          HorizontalAlignment="Left"
                                                                          ItemsSource="{Binding EditKeys}"
                                                                          SelectedItem="{Binding AutoRunKeyChoice, Mode=TwoWay}"
                                                                          AutomationProperties.Name="Auto run key">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Name}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Border>

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding ClassicArPump}"
                                                                  AutomationProperties.Name="Chapter 1 AR and pump">
                                                            <StackPanel>
                                                                <TextBlock Text="Chapter 1 AR and pump" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Chapter 2 Season 1 drops the classic Assault Rifle and Pump Shotgun instead of the Chapter 2 ones."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding BotEmotesDisabled}"
                                                                  AutomationProperties.Name="Stop bots emoting on you">
                                                            <StackPanel>
                                                                <TextBlock Text="Stop bots emoting on you" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Bots no longer dance after eliminating you and skip their warm-up emotes."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <!-- Controller (MainViewModel.Controller.cs, MainWindow.Controller.cs) -->
                                                        <Border Height="1" Background="#14FFFFFF" Margin="0,26,0,22" />
                                                        <TextBlock Text="Controller" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="Xbox, PS4 and PS5 controllers, in the launcher and in game."
                                                                   FontSize="11.5" Foreground="#8A8A8A" Margin="0,4,0,14" />

                                                        <Border Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                                                CornerRadius="10" Padding="14">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding ControllerStatus}" FontSize="14" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding ControllerDetail}" FontSize="11.5"
                                                                           Foreground="{DynamicResource AccentSoftBrush}" TextWrapping="Wrap"
                                                                           Margin="0,4,0,0" />
                                                                <Border Margin="0,12,0,0" Padding="12" CornerRadius="9"
                                                                        Background="#14FFC857" BorderBrush="#44FFC857" BorderThickness="1"
                                                                        Visibility="{Binding ControllerDriverMissing, Converter={StaticResource BoolToVis}}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="One-time step for PlayStation controllers" FontSize="12.5"
                                                                                   FontWeight="Bold" Foreground="#FFC857" />
                                                                        <TextBlock Text="Install the free ViGEmBus driver (it creates the virtual Xbox controller), then press Check again. No restart of Syndicate needed."
                                                                                   FontSize="11.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                                                                   Margin="0,4,0,10" />
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Button Content="DOWNLOAD VIGEMBUS" Style="{StaticResource PrimaryButton}"
                                                                                    Height="32" Padding="14,0" Command="{Binding DownloadControllerDriverCommand}"
                                                                                    AutomationProperties.Name="Download the ViGEmBus driver" />
                                                                            <Button Content="Check again" Style="{StaticResource GhostButton}"
                                                                                    Height="32" Padding="14,0" Margin="8,0,0,0"
                                                                                    Command="{Binding RetryControllerDriverCommand}"
                                                                                    AutomationProperties.Name="Check for the driver again" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding ControllerNavigation}"
                                                                  AutomationProperties.Name="Move around the launcher with a controller">
                                                            <StackPanel>
                                                                <TextBlock Text="Move around the launcher with a controller" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="D-pad or stick to move, A to select, B to go back, Y to play, X for settings, LB / RB to switch screens. Button hints show at the bottom while you use the pad."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,18,0,0"
                                                                  IsChecked="{Binding PlayStationControllers}"
                                                                  AutomationProperties.Name="PS4 and PS5 controller support">
                                                            <StackPanel>
                                                                <TextBlock Text="PS4 / PS5 controller support" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="DualShock 4, DualSense and DualSense Edge, over USB or Bluetooth. While Fortnite runs, the pad shows up as an Xbox controller (old builds only read Xbox pads), so sprint by default and edit on release work on it too."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                    </StackPanel>
                                                </Border>

                                                <!-- 03 Profiles -->

                                                <!-- 03 Display -->
                                                <Border x:Name="SettingsPageDisplay" Style="{StaticResource SettingsCard}"
                                                        Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="Field of view" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="0 = the game default. Works in every season and updates live, even mid-match."
                                                                   FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap"
                                                                   Margin="0,4,0,10" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="54" />
                                                            </Grid.ColumnDefinitions>
                                                            <Slider Style="{StaticResource IceSlider}"
                                                                    Minimum="0" Maximum="130" TickFrequency="1"
                                                                    IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                                                    Value="{Binding Fov, Mode=TwoWay}"
                                                                    AutomationProperties.Name="Field of view" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FovText}" FontSize="20"
                                                                       FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="Fortnite's normal view is about 80. Aiming down sights and scopes still zoom normally."
                                                                   FontSize="11.5" Foreground="#6E6E6E" TextWrapping="Wrap"
                                                                   Margin="0,6,0,0" />

                                                        <Border Height="1" Background="#14FFFFFF" Margin="0,20,0,18" />

                                                        <!-- Crosshair (ViewModels/MainViewModel.Crosshair.cs, drawn in game by SyndicateMenu.dll) -->
                                                        <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding CrosshairEnabled}"
                                                                  AutomationProperties.Name="Custom crosshair">
                                                            <StackPanel>
                                                                <TextBlock Text="Custom crosshair" FontSize="13.5" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Your own crosshair, drawn on the exact centre of the game in every season. Pick a style, then change anything you like."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <TextBlock Text="{Binding CrosshairSummary}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}"
                                                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                                                        <StackPanel IsEnabled="{Binding CrosshairEnabled}" Margin="0,12,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Opacity" Value="0.45" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <!-- Preview: in-game size on the left, magnified on the right. -->
                                                            <Border CornerRadius="10" Height="150" ClipToBounds="True">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#FF6FA8DC" Offset="0" />
                                                                        <GradientStop Color="#FFB7D7EE" Offset="0.55" />
                                                                        <GradientStop Color="#FF6E9A4E" Offset="0.56" />
                                                                        <GradientStop Color="#FF4F7A36" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <controls:CrosshairPreview Settings="{Binding CrosshairPreview}" Zoom="1" />
                                                                    <Border Grid.Column="1" Background="#33000000">
                                                                        <controls:CrosshairPreview Settings="{Binding CrosshairPreview}" Zoom="3" />
                                                                    </Border>
                                                                    <TextBlock Text="IN GAME SIZE" FontSize="9.5" FontWeight="Bold" Foreground="#CCFFFFFF"
                                                                               Margin="10,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Column="1" Text="ZOOMED 3X" FontSize="9.5" FontWeight="Bold" Foreground="#CCFFFFFF"
                                                                               Margin="10,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                                </Grid>
                                                            </Border>

                                                            <!-- Styles -->
                                                            <TextBlock Text="Style" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,8" />
                                                            <ItemsControl ItemsSource="{Binding CrosshairPresetTiles}" Focusable="False">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Command="{Binding DataContext.CrosshairPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding Preset}" Cursor="Hand" Margin="0,0,8,8"
                                                                                ToolTip="{Binding Preset.Name}" AutomationProperties.Name="{Binding Preset.Name}">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="Tile" Width="86" Height="74" CornerRadius="10" BorderThickness="1.5"
                                                                                            Background="#14FFFFFF" BorderBrush="Transparent">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions>
                                                                                                <RowDefinition Height="*" />
                                                                                                <RowDefinition Height="Auto" />
                                                                                            </Grid.RowDefinitions>
                                                                                            <controls:CrosshairPreview Settings="{Binding Sample}" Zoom="2" Margin="4,4,4,0" />
                                                                                            <TextBlock Grid.Row="1" Text="{Binding Preset.Name}" FontSize="10.5" HorizontalAlignment="Center"
                                                                                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="Tile" Property="BorderBrush" Value="#40FFFFFF" />
                                                                                        </Trigger>
                                                                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                        </DataTrigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Colour -->
                                                            <TextBlock Text="Colour" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,8" />
                                                            <WrapPanel>
                                                                <ItemsControl ItemsSource="{Binding CrosshairSwatches}" Focusable="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Command="{Binding DataContext.CrosshairColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    CommandParameter="{Binding Hex}" Cursor="Hand" Margin="0,0,8,8"
                                                                                    ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="Swatch" Width="30" Height="30" CornerRadius="15" BorderThickness="2"
                                                                                                Background="{Binding Hex}" BorderBrush="#26FFFFFF" />
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8" VerticalAlignment="Top">
                                                                    <Border Width="30" Height="30" CornerRadius="6" Background="{Binding CrosshairColor}"
                                                                            BorderBrush="#26FFFFFF" BorderThickness="1" />
                                                                    <TextBox Style="{StaticResource GlassTextBox}" Width="104" Height="32" Padding="8,3" Margin="8,0,0,0"
                                                                             VerticalContentAlignment="Center" MaxLength="7"
                                                                             Text="{Binding CrosshairHex, UpdateSourceTrigger=PropertyChanged}"
                                                                             ToolTip="Any colour as a hex code, for example #00FF78"
                                                                             AutomationProperties.Name="Crosshair colour hex code" />
                                                                </StackPanel>
                                                            </WrapPanel>

                                                            <!-- Size and shape -->
                                                            <TextBlock Text="Shape" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,4" />
                                                            <WrapPanel>
                                                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Lines" IsChecked="{Binding CrosshairLines}" Foreground="{DynamicResource TextBrush}" Margin="0,4,18,4" />
                                                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="T shape (no top line)" IsChecked="{Binding CrosshairTStyle}" Foreground="{DynamicResource TextBrush}" Margin="0,4,18,4" />
                                                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="X (lines turned 45&#176;)" IsChecked="{Binding CrosshairDiagonal}" Foreground="{DynamicResource TextBrush}" Margin="0,4,18,4" />
                                                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Centre dot" IsChecked="{Binding CrosshairDot}" Foreground="{DynamicResource TextBrush}" Margin="0,4,18,4" />
                                                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Round dot" IsChecked="{Binding CrosshairDotRound}" Foreground="{DynamicResource TextBrush}" Margin="0,4,18,4" />
                                                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Circle" IsChecked="{Binding CrosshairCircle}" Foreground="{DynamicResource TextBrush}" Margin="0,4,18,4" />
                                                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Outline" IsChecked="{Binding CrosshairOutline}" Foreground="{DynamicResource TextBrush}" Margin="0,4,18,4" />
                                                            </WrapPanel>

                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.Resources>
                                                                    <Style x:Key="CrossLabel" TargetType="TextBlock">
                                                                        <Setter Property="FontSize" Value="12" />
                                                                        <Setter Property="Foreground" Value="#A8A8A8" />
                                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                                    </Style>
                                                                    <Style x:Key="CrossValue" TargetType="TextBlock">
                                                                        <Setter Property="FontSize" Value="13" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                                    </Style>
                                                                </Grid.Resources>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="130" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="54" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="34" />
                                                                    <RowDefinition Height="34" />
                                                                    <RowDefinition Height="34" />
                                                                    <RowDefinition Height="34" />
                                                                    <RowDefinition Height="34" />
                                                                    <RowDefinition Height="34" />
                                                                    <RowDefinition Height="34" />
                                                                    <RowDefinition Height="34" />
                                                                    <RowDefinition Height="34" />
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0" Text="Line length" Style="{StaticResource CrossLabel}" />
                                                                <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="1" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                        Value="{Binding CrosshairLength, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Crosshair line length" />
                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CrosshairLength, StringFormat={}{0} px}" Style="{StaticResource CrossValue}" />

                                                                <TextBlock Grid.Row="1" Text="Line thickness" Style="{StaticResource CrossLabel}" />
                                                                <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                        Value="{Binding CrosshairThickness, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Crosshair line thickness" />
                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CrosshairThickness, StringFormat={}{0} px}" Style="{StaticResource CrossValue}" />

                                                                <TextBlock Grid.Row="2" Text="Centre gap" Style="{StaticResource CrossLabel}" />
                                                                <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                        Value="{Binding CrosshairGap, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Crosshair centre gap" />
                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CrosshairGap, StringFormat={}{0} px}" Style="{StaticResource CrossValue}" />

                                                                <TextBlock Grid.Row="3" Text="Dot size" Style="{StaticResource CrossLabel}" />
                                                                <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                        Value="{Binding CrosshairDotSize, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Crosshair dot size" />
                                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CrosshairDotSize, StringFormat={}{0} px}" Style="{StaticResource CrossValue}" />

                                                                <TextBlock Grid.Row="4" Text="Circle size" Style="{StaticResource CrossLabel}" />
                                                                <Slider Grid.Row="4" Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="3" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                        Value="{Binding CrosshairCircleRadius, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Crosshair circle size" />
                                                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding CrosshairCircleRadius, StringFormat={}{0} px}" Style="{StaticResource CrossValue}" />

                                                                <TextBlock Grid.Row="5" Text="Circle thickness" Style="{StaticResource CrossLabel}" />
                                                                <Slider Grid.Row="5" Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                        Value="{Binding CrosshairCircleThickness, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Crosshair circle thickness" />
                                                                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding CrosshairCircleThickness, StringFormat={}{0} px}" Style="{StaticResource CrossValue}" />

                                                                <TextBlock Grid.Row="6" Text="Opacity" Style="{StaticResource CrossLabel}" />
                                                                <Slider Grid.Row="6" Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                                        Value="{Binding CrosshairOpacity, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Crosshair opacity" />
                                                                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding CrosshairOpacity, StringFormat={}{0}%}" Style="{StaticResource CrossValue}" />

                                                                <TextBlock Grid.Row="7" Text="Outline thickness" Style="{StaticResource CrossLabel}" />
                                                                <Slider Grid.Row="7" Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="1" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                        Value="{Binding CrosshairOutlineThickness, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Crosshair outline thickness" />
                                                                <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding CrosshairOutlineThickness, StringFormat={}{0} px}" Style="{StaticResource CrossValue}" />

                                                                <TextBlock Grid.Row="8" Text="Outline opacity" Style="{StaticResource CrossLabel}" />
                                                                <Slider Grid.Row="8" Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                                        Value="{Binding CrosshairOutlineOpacity, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Crosshair outline opacity" />
                                                                <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding CrosshairOutlineOpacity, StringFormat={}{0}%}" Style="{StaticResource CrossValue}" />
                                                            </Grid>

                                                            <WrapPanel Margin="0,8,0,0">
                                                                <RadioButton Style="{StaticResource ChipRadio}" Content="BLACK OUTLINE" Padding="14,0" Width="130" GroupName="CrosshairOutlineColour"
                                                                             IsChecked="{Binding CrosshairBlackOutline}" Margin="0,4,0,4" />
                                                                <RadioButton Style="{StaticResource ChipRadio}" Content="WHITE OUTLINE" Padding="14,0" Width="130" GroupName="CrosshairOutlineColour"
                                                                             IsChecked="{Binding CrosshairWhiteOutline}" Margin="0,4,0,4" />
                                                            </WrapPanel>

                                                            <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,14,0,0" IsChecked="{Binding CrosshairHideInMenus}"
                                                                      AutomationProperties.Name="Hide the crosshair in menus">
                                                                <StackPanel>
                                                                    <TextBlock Text="Hide in menus" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="Hidden in the lobby, map, inventory and menus (whenever the mouse cursor shows)."
                                                                               FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                            <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,14,0,0" IsChecked="{Binding CrosshairHideWhenAiming}"
                                                                      AutomationProperties.Name="Hide the crosshair while aiming">
                                                                <StackPanel>
                                                                    <TextBlock Text="Hide while aiming" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="Hidden while you hold the right mouse button (aim down sights and scopes)."
                                                                               FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </CheckBox>

                                                            <Button Content="RESET CROSSHAIR" Style="{StaticResource GhostButton}" Height="34" Padding="16,0"
                                                                    HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding ResetCrosshairCommand}"
                                                                    AutomationProperties.Name="Reset the crosshair to the default" />
                                                        </StackPanel>

                                                        <Border Height="1" Background="#14FFFFFF" Margin="0,20,0,18" />

                                                        <!-- Stretched resolution (ViewModels/MainViewModel.Display.cs) -->
                                                        <TextBlock Text="Stretched resolution" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="Play stretched (for example 1440 x 1080 on a 1080p screen) in every season. Fortnite runs in fullscreen at this size and your monitor stretches it."
                                                                   FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,4,0,10" />
                                                        <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding StretchPresets}" SelectedItem="{Binding SelectedStretchPreset}"
                                                                  Height="34" FontSize="12" HorizontalAlignment="Left" MinWidth="240"
                                                                  AutomationProperties.Name="Stretched resolution preset" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <TextBox Style="{StaticResource GlassTextBox}" Width="90" Height="34" Padding="8,3"
                                                                     VerticalContentAlignment="Center" MaxLength="4"
                                                                     Text="{Binding StretchWidth, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="Stretched width" />
                                                            <TextBlock Text="x" FontSize="15" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="10,0" />
                                                            <TextBox Style="{StaticResource GlassTextBox}" Width="90" Height="34" Padding="8,3"
                                                                     VerticalContentAlignment="Center" MaxLength="4"
                                                                     Text="{Binding StretchHeight, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="Stretched height" />
                                                        </StackPanel>
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <Button Content="APPLY STRETCHED" Style="{StaticResource GhostButton}" Height="36" Padding="16,0"
                                                                    Margin="0,0,8,0" Command="{Binding ApplyStretchCommand}"
                                                                    AutomationProperties.Name="Apply stretched resolution" />
                                                            <Button Content="BACK TO NORMAL" Style="{StaticResource GhostButton}" Height="36" Padding="16,0"
                                                                    Command="{Binding ResetStretchCommand}"
                                                                    AutomationProperties.Name="Turn stretched resolution off" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding StretchStatus}" FontSize="11.5" Foreground="#8A8A8A"
                                                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                                                        <Border Height="1" Background="#14FFFFFF" Margin="0,20,0,18" />

                                                        <TextBlock Text="Launch arguments" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="Extra command-line flags passed to Fortnite when you press play."
                                                                   FontSize="11.5" Foreground="#8A8A8A" Margin="0,4,0,8" />
                                                        <TextBox Style="{StaticResource GlassTextBox}"
                                                                 Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="Launch arguments" />
                                                        <TextBlock Text="Flags are added before the launcher's own match options, so the launcher's values still win."
                                                                   FontSize="11.5" Foreground="#6E6E6E" TextWrapping="Wrap"
                                                                   Margin="0,10,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- 04 Launcher & files -->
                                                <Border x:Name="SettingsPageFiles" Style="{StaticResource SettingsCard}"
                                                        Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="Game folder" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="{Binding DisplayPath}" FontSize="11.5"
                                                                   Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,4,0,10" />
                                                        <Button Content="CHANGE FOLDER" Style="{StaticResource GhostButton}"
                                                                Height="38" Padding="16,0" HorizontalAlignment="Left"
                                                                Command="{Binding BrowseCommand}"
                                                                AutomationProperties.Name="Change game folder" />

                                                        <Border Height="1" Background="#14FFFFFF" Margin="0,20,0,18" />

                                                        <TextBlock Text="Folders" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="Logs and the launcher's local data."
                                                                   FontSize="11.5" Foreground="#8A8A8A" Margin="0,4,0,10" />
                                                        <WrapPanel>
                                                            <Button Content="OPEN LOGS FOLDER" Style="{StaticResource GhostButton}"
                                                                    Height="38" Padding="16,0" Margin="0,0,8,8"
                                                                    Click="OpenLogs_Click" />
                                                            <Button Content="OPEN DATA FOLDER" Style="{StaticResource GhostButton}"
                                                                    Height="38" Padding="16,0" Margin="0,0,8,8"
                                                                    Click="OpenData_Click" />
                                                        </WrapPanel>

                                                        <Border Height="1" Background="#14FFFFFF" Margin="0,18,0,18" />

                                                        <!-- Discord status (Services/DiscordPresence.cs) -->
                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,0,0,4"
                                                                  IsChecked="{Binding DiscordPresenceEnabled}"
                                                                  AutomationProperties.Name="Show Syndicate in Discord">
                                                            <StackPanel>
                                                                <TextBlock Text="Show Syndicate in Discord" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Your Discord profile shows Playing SYNDICATE with the season, mode, players and bots left, and a Join Discord button. It runs in the background and never affects queues or matches."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <Border Height="1" Background="#14FFFFFF" Margin="0,18,0,18" />

                                                        <!-- Antivirus exclusions -->
                                                        <TextBlock Text="Antivirus" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="Add Syndicate&amp;#x2019;s files to Windows Defender so they are not flagged or deleted while you play."
                                                                   FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,4,0,10" />

                                                        <CheckBox Style="{StaticResource SwitchToggle}" Margin="0,0,0,14"
                                                                  IsChecked="{Binding AutoAddExclusions}"
                                                                  AutomationProperties.Name="Add exclusions on startup">
                                                            <StackPanel>
                                                                <TextBlock Text="Add exclusions on startup" FontSize="13.5"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="Silently adds Syndicate&amp;#x2019;s folders to Windows Defender&amp;#x2019;s exclusion list when the launcher opens. Use the button below if you need a prompt."
                                                                           FontSize="11.5" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <WrapPanel>
                                                            <Button Content="ADD TO EXCLUSIONS" Style="{StaticResource GhostButton}"
                                                                    Height="38" Padding="16,0"
                                                                    Command="{Binding AddExclusionsCommand}"
                                                                    AutomationProperties.Name="Add Syndicate files to Windows Defender exclusions" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding ExclusionStatus}" FontSize="11"
                                                                   Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,8,0,0"
                                                                   Visibility="{Binding ExclusionStatusVisibility}" />

                                                        <Border Height="1" Background="#14FFFFFF" Margin="0,18,0,18" />

                                                        <TextBlock Text="About" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="{Binding AboutVersionLine}"
                                                                   FontSize="11.5" Foreground="#B4B4B4" Margin="0,6,0,0" />
                                                        <TextBlock Text="Data: %AppData%\SyndicateLauncher"
                                                                   FontSize="10.5" Foreground="#6E6E6E" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- 05 Themes -->
                                                <Border x:Name="SettingsPageThemes" Visibility="Collapsed" DataContext="{Binding Themes}">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,16">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Now using" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                                                <TextBlock Text="{Binding CurrentThemeName}" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentBrush}" Margin="5,0,0,0" />
                                                            </StackPanel>
                                                            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0"
                                                                    Command="{Binding NewThemeCommand}" AutomationProperties.Name="Create a theme">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                                               VerticalAlignment="Center" Margin="0,0,7,0" />
                                                                    <TextBlock Text="CREATE THEME" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                        <StackPanel Margin="0,0,6,0">
                                                            <Grid Margin="0,0,12,10">
                                                                <TextBlock Text="SIGNATURE" Style="{StaticResource ThemesSectionLabel}" />
                                                                <TextBlock Text="Syndicate, plus the two classic launcher looks" FontSize="10"
                                                                           Foreground="{DynamicResource DimTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <ItemsControl x:Name="SignatureThemeList" ItemsSource="{Binding SignatureThemes}"
                                                                          ItemsPanel="{StaticResource ThreeAcross}" ItemTemplate="{StaticResource ThemeCard}"
                                                                          Focusable="False">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Height" Value="178" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                            </ItemsControl>

                                                            <Grid Margin="0,10,12,10">
                                                                <TextBlock Text="COLOUR THEMES" Style="{StaticResource ThemesSectionLabel}" />
                                                                <TextBlock Text="Hover a card and press remix to make your own version" FontSize="10"
                                                                           Foreground="{DynamicResource DimTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <ItemsControl x:Name="ColourThemeList" ItemsSource="{Binding ColourThemes}"
                                                                          ItemsPanel="{StaticResource FourAcross}" ItemTemplate="{StaticResource ThemeCard}"
                                                                          Focusable="False">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Height" Value="140" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                            </ItemsControl>

                                                            <Grid Margin="0,10,12,10">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="FORTNITE LOBBY THEMES" Style="{StaticResource ThemesSectionLabel}" />
                                                                    <Border CornerRadius="3" Background="#FFE15A" Padding="5,1,5,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="NEW" FontFamily="{StaticResource BurbankFont}" FontSize="10" Foreground="#14161A" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="The lobby art behind the launcher, each with its own weather" FontSize="10"
                                                                           Foreground="{DynamicResource DimTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <ItemsControl x:Name="LobbyThemeList" ItemsSource="{Binding LobbyThemes}"
                                                                          ItemsPanel="{StaticResource ThreeAcross}" ItemTemplate="{StaticResource LobbyThemeCard}"
                                                                          Focusable="False">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Height" Value="150" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                            </ItemsControl>

                                                            <Grid Margin="0,10,12,10">
                                                                <TextBlock Text="YOUR THEMES" Style="{StaticResource ThemesSectionLabel}" />
                                                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                        Content="+ NEW THEME" Command="{Binding NewThemeCommand}"
                                                                        AutomationProperties.Name="New theme" />
                                                            </Grid>
                                                            <ItemsControl x:Name="CustomThemeList" ItemsSource="{Binding CustomThemes}"
                                                                          ItemsPanel="{StaticResource FourAcross}" ItemTemplate="{StaticResource ThemeCard}"
                                                                          Focusable="False"
                                                                          Visibility="{Binding HasCustomThemes, Converter={StaticResource BoolToVis}}">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Height" Value="140" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                            </ItemsControl>
                                                            <Button Style="{StaticResource ThemeCardButton}" Height="96" Margin="0,0,12,12"
                                                                    Command="{Binding NewThemeCommand}" AutomationProperties.Name="Create your first theme">
                                                                <Button.Visibility>
                                                                    <Binding Path="HasCustomThemes" Converter="{StaticResource StateToVis}" ConverterParameter="False" />
                                                                </Button.Visibility>
                                                                <Border CornerRadius="13" BorderBrush="{DynamicResource Accent_55}" BorderThickness="1"
                                                                        Background="{DynamicResource Accent_14}">
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="Create your first theme" FontSize="12.5" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="Pick your own colours and watch the launcher change live." FontSize="10"
                                                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Button>
                                                        </StackPanel>
                                                        <Border x:Name="ThemesEffectsPanel" Margin="0,18,0,0" CornerRadius="14"
                                                                Background="{DynamicResource Tint_E6151515}" BorderBrush="#24FFFFFF" BorderThickness="1">
                                                            <StackPanel Margin="20,18,20,18">
                                                                <Grid>
                                                                    <TextBlock Text="EFFECTS" Style="{StaticResource ThemesSectionLabel}" />
                                                                    <Button Style="{StaticResource LinkButton}" Content="RESET" HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center" Command="{Binding ResetEffectsCommand}"
                                                                            ToolTip="Put every effect back to its default" AutomationProperties.Name="Reset effects" />
                                                                </Grid>
                                                                <TextBlock Text="Live effects run behind and over the launcher and never block a click."
                                                                           Style="{StaticResource ThemesHint}" Margin="0,4,0,14" />

                                                                <!-- Shown while a Fortnite Lobby Theme is picked. -->
                                                                <StackPanel Visibility="{Binding IsLobbyTheme, Converter={StaticResource BoolToVis}}">
                                                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding LobbyMotion}"
                                                                              AutomationProperties.Name="Lobby animations">
                                                                        <StackPanel>
                                                                            <TextBlock Text="Lobby animations" Style="{StaticResource ThemesFieldLabel}" />
                                                                            <TextBlock Text="Slow camera drift over the lobby art plus the theme's own weather. Particles you pick below replace the weather."
                                                                                       Style="{StaticResource ThemesHint}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </CheckBox>
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="44" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="Wallpaper dim" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                        <Slider Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="0.15" Maximum="0.85"
                                                                                SmallChange="0.05" LargeChange="0.1" Value="{Binding WallpaperDim, Mode=TwoWay}"
                                                                                ToolTip="How much the lobby art is darkened behind the text"
                                                                                AutomationProperties.Name="Wallpaper dim" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding WallpaperDimText}" Style="{StaticResource ThemesValue}" />
                                                                    </Grid>
                                                                    <Border Height="1" Background="#14FFFFFF" Margin="0,14,0,14" />
                                                                </StackPanel>

                                                                <TextBlock Text="Particles" Style="{StaticResource ThemesFieldLabel}" />
                                                                <ItemsControl ItemsSource="{Binding ParticleChoices}" ItemsPanel="{StaticResource ChipWrap}"
                                                                              Margin="0,8,0,0" Focusable="False">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="ThemeParticles"
                                                                                         Width="86" Height="32" Margin="0,0,0,6" Content="{Binding Name}"
                                                                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                                         Command="{Binding DataContext.SelectParticlesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                         CommandParameter="{Binding Key}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Grid Margin="0,6,0,0" Visibility="{Binding HasParticles, Converter={StaticResource BoolToVis}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="44" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Slider Style="{StaticResource IceSlider}" Minimum="0.1" Maximum="1" SmallChange="0.05"
                                                                            LargeChange="0.1" Value="{Binding ParticleAmount, Mode=TwoWay}"
                                                                            ToolTip="How many particles" AutomationProperties.Name="Particle amount" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding ParticleAmountText}" Style="{StaticResource ThemesValue}" />
                                                                </Grid>

                                                                <Border Height="1" Background="#14FFFFFF" Margin="0,14,0,14" />

                                                                <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding RgbEdge}"
                                                                          AutomationProperties.Name="RGB edge light">
                                                                    <StackPanel>
                                                                        <TextBlock Text="RGB edge light" Style="{StaticResource ThemesFieldLabel}" />
                                                                        <TextBlock Text="A light that runs around the launcher's edge." Style="{StaticResource ThemesHint}" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                                <StackPanel Visibility="{Binding RgbEdge, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                                                    <ItemsControl ItemsSource="{Binding RgbChoices}" ItemsPanel="{StaticResource ChipWrap}" Focusable="False">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="ThemeRgb"
                                                                                             Width="86" Height="30" Margin="0,0,0,6" Content="{Binding Name}"
                                                                                             FontSize="10"
                                                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                                             Command="{Binding DataContext.SelectRgbStyleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                             CommandParameter="{Binding Key}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <Grid Margin="0,4,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="44" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="Speed" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                        <Slider Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="0.25" Maximum="3"
                                                                                SmallChange="0.05" LargeChange="0.25" Value="{Binding RgbSpeed, Mode=TwoWay}"
                                                                                AutomationProperties.Name="RGB speed" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding RgbSpeedText}" Style="{StaticResource ThemesValue}" />
                                                                    </Grid>
                                                                </StackPanel>

                                                                <Border Height="1" Background="#14FFFFFF" Margin="0,14,0,14" />

                                                                <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding AmbientGlow}"
                                                                          AutomationProperties.Name="Ambient glow">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Ambient glow" Style="{StaticResource ThemesFieldLabel}" />
                                                                        <TextBlock Text="Soft theme-coloured light drifting behind the pages." Style="{StaticResource ThemesHint}" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                                <Grid Margin="0,8,0,0" Visibility="{Binding AmbientGlow, Converter={StaticResource BoolToVis}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="44" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Strength" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                    <Slider Grid.Column="1" Style="{StaticResource IceSlider}" Minimum="0" Maximum="1"
                                                                            SmallChange="0.05" LargeChange="0.1" Value="{Binding GlowStrength, Mode=TwoWay}"
                                                                            AutomationProperties.Name="Glow strength" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding GlowStrengthText}" Style="{StaticResource ThemesValue}" />
                                                                </Grid>

                                                                <Border Height="1" Background="#14FFFFFF" Margin="0,14,0,14" />

                                                                <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding SmoothTransitions}"
                                                                          AutomationProperties.Name="Smooth colour changes">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Smooth colour changes" Style="{StaticResource ThemesFieldLabel}" />
                                                                        <TextBlock Text="Fade into a new theme instead of switching at once." Style="{StaticResource ThemesHint}" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                                <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding PauseInGame}" Margin="0,14,0,0"
                                                                          AutomationProperties.Name="Pause effects in game">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Pause effects in game" Style="{StaticResource ThemesFieldLabel}" />
                                                                        <TextBlock Text="Stops every effect while Fortnite runs so it costs no frames." Style="{StaticResource ThemesHint}" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                                <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding ReduceMotion}" Margin="0,14,0,0"
                                                                          AutomationProperties.Name="Reduce motion">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Reduce motion" Style="{StaticResource ThemesFieldLabel}" />
                                                                        <TextBlock Text="Turns off moving effects and page animations." Style="{StaticResource ThemesHint}" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                                <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding OgLauncher}" Margin="0,14,0,0"
                                                                          AutomationProperties.Name="OG Fortnite Launcher">
                                                                    <StackPanel>
                                                                        <TextBlock Text="OG Fortnite Launcher" Style="{StaticResource ThemesFieldLabel}" />
                                                                        <TextBlock Text="Top tabs, a big Launch button and news cards, like the 2017 launcher." Style="{StaticResource ThemesHint}" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </ScrollViewer>
                                    </Grid>
                                    <Grid x:Name="ThemeEditorRoot" Grid.ColumnSpan="2" DataContext="{Binding Themes}" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{DynamicResource Tint_C4080808}">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding CancelEditorCommand}" />
                                            </Border.InputBindings>
                                        </Border>
                                        <Border x:Name="ThemeEditorSheet" Width="780" MaxHeight="560" VerticalAlignment="Center"
                                                CornerRadius="16" Background="{DynamicResource Tint_F20D0D0D}"
                                                BorderBrush="{DynamicResource Accent_33}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="ThemeEditorScale" />
                                                    <TranslateTransform x:Name="ThemeEditorSlide" />
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="10" Opacity="0.6" />
                                            </Border.Effect>
                                            <Grid Margin="26,22,26,22">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="THEME EDITOR" FontSize="7.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentSoftBrush}" />
                                                        <TextBlock Text="{Binding EditorTitle}" FontFamily="{StaticResource DisplayFont}"
                                                                   FontSize="30" FontWeight="Bold" FontStyle="Italic"
                                                                   Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                                                            VerticalAlignment="Top" Command="{Binding CancelEditorCommand}"
                                                            AutomationProperties.Name="Close theme editor" />
                                                </Grid>

                                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="250" />
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <ContentControl Height="168" Content="{Binding EditorPreview}"
                                                                        ContentTemplate="{StaticResource ThemeMock}" IsTabStop="False" />
                                                        <TextBlock Text="Name" Style="{StaticResource ThemesFieldLabel}" Margin="0,16,0,6" />
                                                        <TextBox Style="{StaticResource GlassTextBox}" MaxLength="24"
                                                                 Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="Theme name" />
                                                        <Button Style="{StaticResource GhostButton}" Height="36" Margin="0,12,0,0"
                                                                Command="{Binding ShuffleEditorCommand}" AutomationProperties.Name="Surprise me">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <TextBlock Text="SURPRISE ME" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Text="Everything previews live on the launcher. Cancel puts your old theme back."
                                                                   Style="{StaticResource ThemesHint}" Margin="0,12,0,0" />
                                                    </StackPanel>

                                                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel Margin="0,0,6,0">
                                                            <!-- Accent -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="118" />
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="92" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Accent" Style="{StaticResource ThemesFieldLabel}" VerticalAlignment="Center" />
                                                                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{Binding EditorAccentBrush}"
                                                                        BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Left" />
                                                                <TextBox Grid.Column="2" Style="{StaticResource GlassTextBox}" Padding="8,5" FontSize="11.5"
                                                                         Text="{Binding EditorAccent, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"
                                                                         AutomationProperties.Name="Accent colour" />
                                                                <Slider Grid.Column="3" Style="{StaticResource HueSlider}" Margin="12,0,0,0"
                                                                        Value="{Binding EditorAccentHue, Mode=TwoWay}" ToolTip="Accent hue"
                                                                        AutomationProperties.Name="Accent hue" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding AccentSwatches}" ItemsPanel="{StaticResource ChipWrap}"
                                                                          Margin="146,8,0,0" Focusable="False">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}"
                                                                                ToolTip="{Binding Hex}" CommandParameter="{Binding Parameter}"
                                                                                Command="{Binding DataContext.SwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Second accent -->
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="118" />
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="92" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Second accent" Style="{StaticResource ThemesFieldLabel}" VerticalAlignment="Center" />
                                                                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{Binding EditorAccent2Brush}"
                                                                        BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Left" />
                                                                <TextBox Grid.Column="2" Style="{StaticResource GlassTextBox}" Padding="8,5" FontSize="11.5"
                                                                         Text="{Binding EditorAccent2, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"
                                                                         AutomationProperties.Name="Second accent colour" />
                                                                <Slider Grid.Column="3" Style="{StaticResource HueSlider}" Margin="12,0,0,0"
                                                                        Value="{Binding EditorAccent2Hue, Mode=TwoWay}" ToolTip="Second accent hue"
                                                                        AutomationProperties.Name="Second accent hue" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Accent2Swatches}" ItemsPanel="{StaticResource ChipWrap}"
                                                                          Margin="146,8,0,0" Focusable="False">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}"
                                                                                ToolTip="{Binding Hex}" CommandParameter="{Binding Parameter}"
                                                                                Command="{Binding DataContext.SwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Border Height="1" Background="#14FFFFFF" Margin="0,8,0,12" />

                                                            <!-- Background -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="118" />
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="92" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Background" Style="{StaticResource ThemesFieldLabel}" VerticalAlignment="Center" />
                                                                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{Binding EditorBackgroundBrush}"
                                                                        BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Left" />
                                                                <TextBox Grid.Column="2" Style="{StaticResource GlassTextBox}" Padding="8,5" FontSize="11.5"
                                                                         Text="{Binding EditorBackground, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"
                                                                         AutomationProperties.Name="Background colour" />
                                                                <TextBlock Grid.Column="3" Text="Tint" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                                           VerticalAlignment="Center" Margin="12,0,8,0" />
                                                                <Slider Grid.Column="4" Style="{StaticResource IceSlider}" Minimum="0" Maximum="1"
                                                                        SmallChange="0.02" LargeChange="0.1" Value="{Binding EditorTint, Mode=TwoWay}"
                                                                        ToolTip="How much of the accent colours the background"
                                                                        AutomationProperties.Name="Background tint" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding BackgroundSwatches}" ItemsPanel="{StaticResource ChipWrap}"
                                                                          Margin="146,8,0,0" Focusable="False">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}"
                                                                                ToolTip="{Binding Hex}" CommandParameter="{Binding Parameter}"
                                                                                Command="{Binding DataContext.SwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Surface and text -->
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="118" />
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="92" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Panels" Style="{StaticResource ThemesFieldLabel}" VerticalAlignment="Center" />
                                                                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{Binding EditorSurfaceBrush}"
                                                                        BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Left" />
                                                                <TextBox Grid.Column="2" Style="{StaticResource GlassTextBox}" Padding="8,5" FontSize="11.5"
                                                                         Text="{Binding EditorSurface, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"
                                                                         AutomationProperties.Name="Panel colour" />
                                                                <TextBlock Grid.Column="3" Text="Cards, buttons and raised panels." Style="{StaticResource ThemesHint}"
                                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                            </Grid>
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="118" />
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="92" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Text" Style="{StaticResource ThemesFieldLabel}" VerticalAlignment="Center" />
                                                                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{Binding EditorTextBrush}"
                                                                        BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Left" />
                                                                <TextBox Grid.Column="2" Style="{StaticResource GlassTextBox}" Padding="8,5" FontSize="11.5"
                                                                         Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"
                                                                         AutomationProperties.Name="Text colour" />
                                                                <TextBlock Grid.Column="3" Text="Titles and labels. Keep it light." Style="{StaticResource ThemesHint}"
                                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Grid>

                                                <Grid Grid.Row="2" Margin="0,18,0,0">
                                                    <TextBlock Text="{Binding EditorError}" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,260,0" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource GhostButton}" Height="38" Padding="18,0" Content="CANCEL"
                                                                Command="{Binding CancelEditorCommand}" AutomationProperties.Name="Cancel" />
                                                        <Button Style="{StaticResource PrimaryButton}" Height="38" MinWidth="140" Margin="10,0,0,0"
                                                                Content="SAVE THEME" Command="{Binding SaveEditorCommand}"
                                                                AutomationProperties.Name="Save theme" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ======================= DIAGNOSTICS ======================= -->
                    <!-- Ported from Syndicate: a slim bar docked at the bottom. The log body is an
                         overlay above the bar, so opening it never shrinks or clips the page. -->
                    <Border x:Name="DiagnosticsBody" Grid.Row="1" VerticalAlignment="Bottom" Height="0"
                            ClipToBounds="True" Background="#F70A0A0E" BorderBrush="#1FFFFFFF"
                            BorderThickness="0,1,0,0" Panel.ZIndex="30">
                        <ScrollViewer x:Name="DiagnosticsScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DiagnosticsLines" Margin="18,7,18,9" />
                        </ScrollViewer>
                    </Border>

                    <Border x:Name="DiagnosticsBar" Grid.Row="2" Background="#F20A0A0E"
                            BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,15,0">
                        <Grid Height="42" Margin="12,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="DiagnosticsToggle" Style="{StaticResource DiagnosticsHeaderButton}"
                                    Height="30" Padding="10,0" VerticalAlignment="Center"
                                    Click="DiagnosticsToggle_Click" ToolTip="Show or hide the log"
                                    AutomationProperties.Name="Diagnostics">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="DiagnosticsChevron" Text="&#xE70E;"
                                               FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource DimTextBrush}" Margin="0,0,9,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="DIAGNOSTICS" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                    <Border x:Name="DiagnosticsErrorChip" Visibility="Collapsed"
                                            Background="#40FF5A6A" CornerRadius="8" Padding="7,1"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DiagnosticsErrorText" FontSize="10"
                                                   FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="DiagnosticsStatus" Grid.Column="1" Text="Ready" FontSize="11"
                                       Foreground="{DynamicResource DimTextBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="14,0" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="COPY LOG" Style="{StaticResource DiagnosticsLinkButton}"
                                        Click="DiagnosticsCopy_Click"
                                        ToolTip="Copy the whole log, to paste it when asking for help" />
                                <Button Content="CLEAR" Style="{StaticResource DiagnosticsLinkButton}"
                                        Click="DiagnosticsClear_Click" ToolTip="Empty the log" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Themes tab: particles and the RGB edge light, drawn over the pages but never taking clicks. -->
                <controls:ThemeEffectsLayer x:Name="ThemeOverlay" Grid.ColumnSpan="2" Mode="Overlay" Panel.ZIndex="50" EdgeRadius="8" />
            </Grid>
        </Border>

        <!-- ======================= PLAYER SELECT ======================= -->
        <Grid x:Name="PlayerSelectRoot" Panel.ZIndex="100" Background="#C406070C"
              Visibility="{Binding IsPlayerSelectOpen, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="PlayerSelectBackdrop_MouseLeftButtonDown">
            <Border x:Name="PlayerSelectCard" Width="860" Height="610" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="16" Background="{DynamicResource Tint_F20D0D0D}" BorderBrush="#26FFFFFF" BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PlayerSelectScale" />
                        <TranslateTransform x:Name="PlayerSelectSlide" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="10" Opacity="0.55" />
                </Border.Effect>
                <Grid>
                    <Rectangle RadiusX="16" RadiusY="16" Fill="{StaticResource FineGridBrush}"
                               Opacity="0.55" IsHitTestVisible="False" />
                    <Rectangle RadiusX="16" RadiusY="16" Fill="{StaticResource DotFieldBrush}"
                               Opacity="0.6" IsHitTestVisible="False" />
                    <Grid Margin="26,22,26,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PLAYER" FontSize="8" FontWeight="Bold" Foreground="#8A8A8A" />
                            <TextBlock Text="CHOOSE PLAYER" FontFamily="{StaticResource DisplayFont}" FontSize="38"
                                       FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource TextBrush}"
                                       LineHeight="36" Margin="0,2,0,0" />
                            <Path x:Name="PlayerSelectScribble" Width="260" Height="10" HorizontalAlignment="Left"
                                  Margin="2,4,0,0" Stretch="Fill" Data="M 2,7 C 40,1 78,11 116,5 C 154,-1 192,9 230,4 C 244,2 252,3 258,5"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeDashArray="150 150" StrokeDashOffset="300" IsHitTestVisible="False" />
                            <TextBlock Text="Pick a player, choose their profile picture, or create a new player."
                                       FontSize="11.5" Foreground="#8A8A8A" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Width="36" Height="36"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding ClosePlayerSelectCommand}"
                                ToolTip="Close" AutomationProperties.Name="Close player select">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Players -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="12" Background="#10FFFFFF" BorderBrush="#1FFFFFFF"
                                    BorderThickness="1" Padding="8">
                                <ListBox Style="{StaticResource ProfileListBox}"
                                         ItemsSource="{Binding Profiles}"
                                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                         KeyDown="PlayerList_KeyDown"
                                         AutomationProperties.Name="Players">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ContextMenu>
                                                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                                                        <MenuItem Header="Delete player" Style="{StaticResource DarkMenuItem}"
                                                                  Click="DeleteProfileMenuItem_Click"
                                                                  CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="20"
                                                        Background="{DynamicResource Tint_FF202020}" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ModeLabel}" FontSize="9.5"
                                                               Foreground="{DynamicResource DimTextBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- New player -->
                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Text="New player" FontSize="11" FontWeight="Bold" Foreground="#9A9A9A" />
                                <TextBox Style="{StaticResource GlassTextBox}" Margin="0,7,0,0"
                                         Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="New player name" />
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="NewProfileMode"
                                                 Content="Progression" Margin="0,0,6,0" MinWidth="132" Height="36"
                                                 Padding="18,0" HorizontalContentAlignment="Center"
                                                 IsChecked="{Binding NewProfileIsProgression, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="NewProfileMode"
                                                 Content="Unlock All" MinWidth="132" Height="36"
                                                 Padding="18,0" HorizontalContentAlignment="Center"
                                                 IsChecked="{Binding NewProfileIsUnlockedAll, Mode=TwoWay}" />
                                </StackPanel>
                                <Button Content="CREATE PLAYER" Style="{StaticResource PrimaryButton}" Height="34"
                                        Margin="0,9,0,0" Command="{Binding CreateProfileCommand}"
                                        AutomationProperties.Name="Create player" />
                                <TextBlock Text="{Binding ProfileError}" FontSize="10" Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Profile picture -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="PROFILE PICTURE" FontSize="8" FontWeight="Bold" Foreground="#8A8A8A" />
                                <TextBlock Text="{Binding PlayerName}" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                           FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource TextBrush}"
                                           Margin="0,2,0,0" />
                                <!-- Manage the selected player. Each button opens a confirmation step first. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                    <StackPanel.Resources>
                                        <Style x:Key="PlayerActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Height" Value="30" />
                                            <Setter Property="Padding" Value="11,0" />
                                            <Setter Property="FontSize" Value="10" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Margin" Value="0,0,7,0" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button Style="{StaticResource PlayerActionButton}" Command="{Binding StartRenamePlayerCommand}"
                                            ToolTip="Change this player's name. Everything they own stays."
                                            AutomationProperties.Name="Rename player">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,7,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="RENAME" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PlayerActionButton}" Command="{Binding StartSwitchModeCommand}"
                                            ToolTip="Switch this player between Progression and Unlock All."
                                            AutomationProperties.Name="Switch player mode">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,7,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding SwitchModeButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PlayerActionButton}" Command="{Binding StartDeletePlayerCommand}"
                                            ToolTip="Delete this player and their game save from this PC."
                                            AutomationProperties.Name="Delete player">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,7,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                                            <TextBlock Text="DELETE" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!-- Unlock All: BR only, or with Save the World skins (MainViewModel.Players.cs) -->
                                <StackPanel Visibility="{Binding ShowStwSkinsOption, Converter={StaticResource BoolToVis}}" Margin="0,6,0,6">
                                    <TextBlock Text="Unlock All locker" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                    <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding StwSkinsOptions}"
                                              SelectedIndex="{Binding SelectedStwSkinsOption}" Height="32" FontSize="12"
                                              HorizontalAlignment="Left" MinWidth="240" Margin="0,5,0,0"
                                              AutomationProperties.Name="Unlock All locker contents" />
                                </StackPanel>
                                <TextBlock Text="Pick a picture below, or choose one from this PC. It saves straight away."
                                           FontSize="11" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <Button Content="CHOOSE IMAGE FROM PC" Style="{StaticResource PrimaryButton}" Height="36"
                                        HorizontalAlignment="Left" Padding="18,0" Margin="0,0,0,4"
                                        Command="{Binding ChooseCustomAvatarCommand}"
                                        AutomationProperties.Name="Choose a custom profile picture"
                                        ToolTip="Pick a PNG, JPG, BMP or GIF from this PC" />
                                <TextBlock Text="{Binding AvatarError}" FontSize="10" Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,8"
                                           Visibility="{Binding HasAvatarError, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <ListBox Grid.Row="1" Style="{StaticResource AvatarList}"
                                     ItemsSource="{Binding AvatarChoices}"
                                     SelectedItem="{Binding SelectedAvatar, Mode=TwoWay}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Profile pictures">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="Players and pictures are saved on this PC." FontSize="10" Foreground="#6E6E6E"
                                   VerticalAlignment="Center" />
                        <Button Content="DONE" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="120"
                                HorizontalAlignment="Right" Command="{Binding ClosePlayerSelectCommand}"
                                AutomationProperties.Name="Done choosing player" />
                    </Grid>
                </Grid>

                <!-- Confirmation step for Rename / Switch mode / Delete (MainViewModel.Players.cs). -->
                <Grid Visibility="{Binding IsPlayerActionOpen, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="16" Background="#B3050608" />
                    <Border Width="470" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14"
                            Background="{DynamicResource Tint_F2161616}" BorderThickness="1" Padding="24,20,24,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent_55}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlayerActionIsDanger}" Value="True">
                                        <Setter Property="BorderBrush" Value="#99FF5A6E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="16" CornerRadius="2" Margin="0,0,9,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlayerActionIsDanger}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="ARE YOU SURE?" FontSize="9" FontWeight="Bold" Foreground="#8A8A8A" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding PlayerActionTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                                       FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding PlayerActionBody}" FontSize="11.5" Foreground="#B4B4B4"
                                       TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0" />
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding PlayerActionNeedsInput, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PlayerActionInputLabel}" FontSize="8.5" FontWeight="Bold" Foreground="#8A8A8A" />
                                <TextBox Style="{StaticResource GlassTextBox}" Margin="0,6,0,0" MaxLength="16"
                                         Text="{Binding PlayerActionInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Player name" />
                            </StackPanel>
                            <TextBlock Text="{Binding PlayerActionError}" FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding HasPlayerActionError, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Style="{StaticResource GhostButton}" Height="36" Padding="18,0" Margin="0,0,10,0"
                                        Content="CANCEL" Command="{Binding CancelPlayerActionCommand}"
                                        AutomationProperties.Name="Cancel" />
                                <Button Height="36" Padding="18,0" Command="{Binding ConfirmPlayerActionCommand}"
                                        Content="{Binding PlayerActionConfirmText}" AutomationProperties.Name="Confirm">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlayerActionIsDanger}" Value="True">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" CornerRadius="5" Background="#D9E5485C"
                                                                        BorderBrush="#FF8A98" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      TextElement.Foreground="White" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#FFF0566A" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#40E5485C" />
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#55FF8A98" />
                                                                        <Setter Property="Cursor" Value="Arrow" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= STARTUP COVER ======================= -->
        <!-- The splash (LaunchSplash.cs, its own window) ends on this plain theme background; the cover starts
             the same, so the hand-over has no seam, then fades to show the launcher (MainWindow.xaml.cs OnLoaded). -->
        <Border x:Name="LaunchCover" Panel.ZIndex="200" Focusable="False" Background="{DynamicResource Tint_FF0C0C0C}" />
    </Grid>
</Window>
