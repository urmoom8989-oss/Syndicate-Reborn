<Window x:Class="SyndicateLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SyndicateLauncher.Views"
        xmlns:ui="clr-namespace:SyndicateLauncher"
        xmlns:controls="clr-namespace:SyndicateLauncher.Controls"
        Title="Syndicate Launcher"
        Width="1248" Height="728"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{DynamicResource Tint_FF0C0C0C}"
        ResizeMode="CanMinimize"
        Icon="Assets/syndicate.ico"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- A normal (not layered) borderless window: Windows draws the shadow and, on Windows 11, the rounded
         corners (see OnSourceInitialized). AllowsTransparency="True" made every animation frame copy the whole
         window back from the GPU, which is what used most of the launcher's CPU and caused the stutter. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ClosePlayerSelectCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource DimTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Found">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasBuildWarning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Detecting">
                    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Problem">
                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfileDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource DimTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProfile}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Profile mode choice (Progression / Unlocked All): a themed option card with a cyan
             indicator, matching the profile list (ProfileItem) and DarkCheckBox in Theme.xaml. -->
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" CornerRadius="8" Padding="12,10" Background="#08FFFFFF"
                                BorderBrush="#16FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="17" Height="17" VerticalAlignment="Top" Margin="0,1,11,0">
                                    <Ellipse x:Name="Ring" Fill="{DynamicResource Tint_FF161616}" Stroke="#2AFFFFFF" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#F2F3F5" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#12FFFFFF" />
                                <Setter TargetName="Ring" Property="Stroke" Value="#66FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Accent_1A}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent_55}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeasonWheel" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <controls:RadialPanel Radius="205" Diameter="520" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeasonWheelItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="17" Background="#003BD9FF" />
                            <Border x:Name="Bd" CornerRadius="15" BorderBrush="#24FFFFFF" BorderThickness="1"
                                    Background="{DynamicResource Tint_FF181818}">
                                <ContentPresenter Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent_66}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="{DynamicResource Accent_25}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent_CC}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F2F3F5" BlurRadius="16" ShadowDepth="0" Opacity="0.35" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SeasonTile">
            <Grid ToolTip="{Binding AvailabilityNote}" AutomationProperties.Name="{Binding Name}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReleased}" Value="False">
                                <Setter Property="Opacity" Value="0.7" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border CornerRadius="12" Background="{Binding CoverBrush}" />
                <Border CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#59000000" Offset="0" />
                            <GradientStop Color="#B8000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Rectangle Fill="{StaticResource FineGridBrush}" Opacity="0.35" IsHitTestVisible="False" />
                <Grid Margin="8,7,8,7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="S E A S O N" FontSize="6" FontWeight="Bold" Foreground="{Binding AccentSoftBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="{Binding Code}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="29" FontWeight="Bold" FontStyle="Italic" Foreground="{Binding TitleGradient}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Chapter page season grid. The cards are selectable list items so the existing
             SelectedSeason / OpenWheelSeason flow still drives build selection. -->
        <Style x:Key="SeasonGridList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" CanContentScroll="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeasonGridItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="11" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                    Background="{DynamicResource Tint_D6161616}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Border>
                            <Border x:Name="SelectRing" CornerRadius="11" BorderBrush="Transparent"
                                    BorderThickness="2" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent_66}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SelectRing" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F2F3F5" BlurRadius="16" ShadowDepth="0" Opacity="0.35" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectRing" Property="BorderBrush" Value="{DynamicResource Accent_CC}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SeasonGridCard">
            <Grid Height="118" ToolTip="{Binding AvailabilityNote}" AutomationProperties.Name="{Binding Name}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReleased}" Value="False">
                                <Setter Property="Opacity" Value="0.62" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border x:Name="ArtClip" CornerRadius="10" ClipToBounds="True"
                        SizeChanged="RoundedClip_SizeChanged">
                    <Grid>
                        <Border Background="{Binding CoverBrush}" />
                        <Image Source="{Binding CardArt}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#10000000" Offset="0" />
                                    <GradientStop Color="#7A000000" Offset="0.52" />
                                    <GradientStop Color="#E6000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="13,0,13,10">
                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource BurbankFont}"
                                       FontSize="24" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource DimTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReleased}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ReleaseLabel}" FontSize="7" FontWeight="Bold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReleased}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding BuildVersionsLabel}" FontSize="7" FontWeight="Bold"
                                           Foreground="#8C8C8C" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ============================== Diagnostics ============================== -->
        <Style x:Key="DiagnosticsHeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiagnosticsLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#10FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Tint_F2161616}" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AvatarTile" TargetType="ListBoxItem">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" CornerRadius="10" Background="{DynamicResource Tint_FF161616}"
                                BorderBrush="#33FFFFFF" BorderThickness="1.5" Padding="2"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="TileScale" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#66FFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.07" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.07" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.04" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.04" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AvatarList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AvatarTile}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===== OG Fortnite Launcher (Themes) ===== -->
        <!-- Text tab in the top bar; ui:Ui.Active underlines it with the success colour. -->
        <Style x:Key="OgTab" TargetType="Button">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <ContentPresenter Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Line" Height="2" Margin="8,0" VerticalAlignment="Bottom"
                                    Background="{DynamicResource SuccessBrush}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="ui:Ui.Active" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The big flat Launch button; Tag="Cog" gives the darker settings segment beside it. -->
        <Style x:Key="OgLaunchButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="Foreground" Value="#0E2A1C" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" />
                            <Border x:Name="Shade" Background="#000000" Opacity="0" />
                            <Border x:Name="Lift" Background="#FFFFFF" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Cog">
                                <Setter TargetName="Shade" Property="Opacity" Value="0.22" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Lift" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Lift" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Lift" Property="Opacity" Value="0" />
                                <Setter TargetName="Shade" Property="Opacity" Value="0.3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small white glyph link under "Visit Syndicate on". -->
        <Style x:Key="OgLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Width="22" Height="22" Margin="0,0,10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- News card: picture (Background), title (Content) and a small "Read More" line (Tag) over a dark fade. -->
        <Style x:Key="OgNewsCard" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" />
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.45" />
                                        <GradientStop Color="#D9000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Lift" Background="#FFFFFF" Opacity="0" />
                            <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,12">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="8.5" Foreground="#B5B5B5" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Lift" Property="Opacity" Value="0.07" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Lift" Property="Opacity" Value="0.07" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="8" Background="{DynamicResource Tint_FF0C0C0C}" BorderBrush="#2AFFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- OG Fortnite Launcher (Themes): the sidebar gives way to the tab bar along the top. -->
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="178" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Themes.OgLauncher}" Value="True">
                                        <Setter Property="Width" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Fortnite Lobby Themes: the lobby art behind every page, with a slow camera drift (Controls/LobbyWallpaper.cs). -->
                <controls:LobbyWallpaper x:Name="LobbyArt" Grid.ColumnSpan="2" />

                <!-- Themes tab: ambient glow behind everything (see Controls/ThemeEffectsLayer.cs). -->
                <controls:ThemeEffectsLayer x:Name="ThemeBackdrop" Grid.ColumnSpan="2" Mode="Backdrop" />

                <!-- ======================= SIDEBAR ======================= -->
                <Border Grid.Column="0" CornerRadius="7,0,0,7" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Themes.OgLauncher}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource TintColor_FF151515}" Offset="0" />
                            <GradientStop Color="{DynamicResource TintColor_FF0C0C0C}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Rectangle Fill="{StaticResource FineGridBrush}" Opacity="0.3" IsHitTestVisible="False" />
                        <Grid Margin="14,16,14,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Width="56" Height="56" CornerRadius="13" Background="{DynamicResource Tint_FF1B1B1B}"
                                        BorderBrush="#3F3F43" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="NavLogoGlow" Color="#FFFFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.28" />
                                    </Border.Effect>
                                    <Image Source="Assets/logo.png" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="SidebarNav" Grid.Row="1" Margin="0,24,0,0">
                                <TextBlock Text="M E N U" FontSize="8" FontWeight="Bold"
                                           Foreground="#727272" Margin="16,0,0,9" />

                                <Button Style="{StaticResource NavButton}" Content="Home"
                                        Tag="&#xE80F;" ui:Ui.Active="{Binding IsHomeScreen}" Command="{Binding HomeCommand}"
                                        AutomationProperties.Name="Home" />
                                <Button Style="{StaticResource NavButton}" Content="Play"
                                        Tag="&#xE768;" ui:Ui.Active="{Binding IsPlayScreen}"
                                        Command="{Binding OpenPlayCommand}"
                                        ToolTip="Browse every season"
                                        AutomationProperties.Name="Play" />
                                <!-- Syndicate Studio (Dev launcher only, shown by MainWindow.xaml.cs): the match editor ported from Tilted Studio. -->
                                <Button x:Name="StudioNavButton" Style="{StaticResource NavButton}" Content="Studio"
                                        Tag="&#xE70F;" ui:Ui.Active="{Binding IsStudioScreen}"
                                        Command="{Binding OpenStudioScreenCommand}" Visibility="Collapsed"
                                        ToolTip="Syndicate Studio: run a match server, see the island and edit the map live"
                                        AutomationProperties.Name="Studio" />
                                <Button Style="{StaticResource NavButton}" Content="Settings"
                                        Tag="&#xE713;" Command="{Binding ToggleSettingsCommand}"
                                        AutomationProperties.Name="Settings" />
                                <Border Height="1" Background="#12FFFFFF" Margin="13,9,13,10" />
                                <Button Style="{StaticResource NavButton}" Content="Discord"
                                        Tag="&#xE8BD;" Command="{Binding OpenCommunityCommand}"
                                        ToolTip="Join the Syndicate Discord"
                                        AutomationProperties.Name="Discord" />
                                <Button Style="{StaticResource NavButton}" Content="Support"
                                        Tag="&#xE897;" Command="{Binding OpenSupportCommand}"
                                        ToolTip="Get support in the Syndicate Discord"
                                        AutomationProperties.Name="Support" />
                                <Button Style="{StaticResource NavButton}" Content="Credits"
                                        Tag="&#xE716;" ui:Ui.Active="{Binding IsCreditsScreen}"
                                        Command="{Binding OpenCreditsCommand}"
                                        ToolTip="Meet the people behind Syndicate"
                                        AutomationProperties.Name="Credits" />
                                <Button Style="{StaticResource NavButton}" Content="Patch Notes"
                                        Tag="&#xE8A5;" ui:Ui.Active="{Binding IsPatchNotesScreen}"
                                        Command="{Binding OpenPatchNotesCommand}"
                                        ToolTip="See what's new in this version of Syndicate"
                                        AutomationProperties.Name="Patch Notes" />
                                <Button Style="{StaticResource NavButton}" Content="Donate"
                                        Tag="&#xE00B;" Command="{Binding OpenDonateCommand}"
                                        ToolTip="Support Syndicate on Buy Me a Coffee"
                                        AutomationProperties.Name="Donate" />
                            </StackPanel>

                            <Border Grid.Row="3" Height="168" CornerRadius="11" ClipToBounds="True"
                                    BorderBrush="#2A747474" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource TintColor_FF2D2D2D}" Offset="0" />
                                        <GradientStop Color="{DynamicResource TintColor_FF111111}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Image Source="Assets/og-card.png" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource TintColor_990F0F0F}" Offset="0" />
                                                <GradientStop Color="{DynamicResource TintColor_330F0F0F}" Offset="0.5" />
                                                <GradientStop Color="#0005111A" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Grid Margin="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="15" FontWeight="Bold" FontStyle="Italic"
                                                       LineHeight="15" Foreground="#FFFFFF" Text="PLAY&#10;THE OG&#10;WAY." />
                                            <Border Width="20" Height="2" Background="{DynamicResource AccentBrush}"
                                                    HorizontalAlignment="Left" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4" Margin="3,10,3,0">
                                <Button Command="{Binding OpenPatchNotesCommand}" Cursor="Hand" HorizontalAlignment="Left"
                                        ToolTip="See what's new (Patch Notes)" AutomationProperties.Name="Version, open patch notes"
                                        FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="VersionText" Text="{Binding LauncherVersionText}" FontSize="12.5"
                                                       FontWeight="SemiBold" Foreground="#A4A4A4" VerticalAlignment="Center"
                                                       Background="Transparent" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="VersionText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Setter TargetName="VersionText" Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ======================= MAIN ======================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="64" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Themes.OgLauncher}" Value="True">
                                            <Setter Property="Height" Value="38" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ======================= OG LAUNCHER TAB BAR ======================= -->
                    <!-- Shown instead of the sidebar and title when Themes > OG Fortnite Launcher is on: a flat dark
                         bar with the logo, text tabs (the open one underlined) and the window buttons on the right. -->
                    <Grid Grid.Row="0" Background="{DynamicResource Tint_FF1E1E1E}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                          Visibility="{Binding Themes.OgLauncher, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="#14FFFFFF" />
                        <Border Width="26" Height="26" Margin="10,0,14,0" CornerRadius="4" ClipToBounds="True"
                                Background="{DynamicResource Tint_FF2D2D2D}" VerticalAlignment="Center">
                            <Image Source="Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource OgTab}" Content="HOME" ui:Ui.Active="{Binding IsHomeScreen}"
                                    Command="{Binding HomeCommand}" AutomationProperties.Name="Home" />
                            <Button Style="{StaticResource OgTab}" Content="PLAY" ui:Ui.Active="{Binding IsPlayScreen}"
                                    Command="{Binding OpenPlayCommand}" AutomationProperties.Name="Play" />
                            <Button Style="{StaticResource OgTab}" Content="STUDIO" ui:Ui.Active="{Binding IsStudioScreen}"
                                    Command="{Binding OpenStudioScreenCommand}" AutomationProperties.Name="Studio"
                                    Visibility="{Binding Visibility, ElementName=StudioNavButton}" />
                            <Button Style="{StaticResource OgTab}" Content="SETTINGS" ui:Ui.Active="{Binding IsSettingsOpen}"
                                    Command="{Binding ToggleSettingsCommand}" AutomationProperties.Name="Settings" />
                            <Button Style="{StaticResource OgTab}" Content="CREDITS" ui:Ui.Active="{Binding IsCreditsScreen}"
                                    Command="{Binding OpenCreditsCommand}" AutomationProperties.Name="Credits" />
                            <Button Style="{StaticResource OgTab}" Content="PATCH NOTES" ui:Ui.Active="{Binding IsPatchNotesScreen}"
                                    Command="{Binding OpenPatchNotesCommand}" AutomationProperties.Name="Patch Notes" />
                            <Button Style="{StaticResource OgTab}" Content="DISCORD"
                                    Command="{Binding OpenCommunityCommand}" AutomationProperties.Name="Discord" />
                            <Button Style="{StaticResource OgTab}" Content="SUPPORT"
                                    Command="{Binding OpenSupportCommand}" AutomationProperties.Name="Support" />
                            <Button Style="{StaticResource OgTab}" Content="DONATE"
                                    Command="{Binding OpenDonateCommand}" AutomationProperties.Name="Donate" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,14,0" Padding="0"
                                    Command="{Binding OpenPlayerSelectCommand}" ToolTip="Choose player and profile picture"
                                    AutomationProperties.Name="Player profile" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <Ellipse x:Name="OgDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="OgName" Text="{Binding PlayerName}" FontSize="11" Foreground="#A8A8A8"
                                                       Margin="7,0,0,0" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="7" Foreground="#7A7A7A"
                                                       Margin="6,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="OgName" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Border Width="1" Height="16" Background="#1FFFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Border Visibility="{Binding Visibility, ElementName=DevBadge}" IsHitTestVisible="False"
                                    VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,2" CornerRadius="3"
                                    Background="#33FFB020" BorderBrush="#FFB020" BorderThickness="1">
                                <TextBlock Text="DEV" FontSize="9" FontWeight="Bold" Foreground="#FFC857" />
                            </Border>
                            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" Height="26"
                                    ToolTip="Minimize" AutomationProperties.Name="Minimize" Content="&#xE921;" />
                            <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" Height="26" Margin="2,0,0,0"
                                    ToolTip="Close" AutomationProperties.Name="Close" Content="&#xE8BB;" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Themes.OgLauncher}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                            <TextBlock Text="SYNDICATE" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                       FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource TextBrush}" />
                            <Border Width="1" Height="16" Background="#26FFFFFF" Margin="12,1,12,0" />
                            <TextBlock Text="R E S T O R A T I O N   P R O J E C T" FontSize="8"
                                       FontWeight="SemiBold" Foreground="#878787" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,11,0">
                            <!-- Shown only in launchers built by UPDATE FROM GIT.cmd (DEV_BUILD), so devs can tell them from a release. -->
                            <Border x:Name="DevBadge" Visibility="Collapsed" IsHitTestVisible="False"
                                    VerticalAlignment="Center" Margin="0,0,16,0"
                                    Padding="10,3" CornerRadius="5" Background="#33FFB020"
                                    BorderBrush="#FFB020" BorderThickness="1">
                                <TextBlock Text="DEV LAUNCHER" FontFamily="{StaticResource DisplayFont}" FontSize="11"
                                           FontWeight="Bold" Foreground="#FFC857" />
                            </Border>
                            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click"
                                    ToolTip="Minimize" AutomationProperties.Name="Minimize"
                                    Content="&#xE921;" />
                            <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" Margin="3,0,0,0"
                                    ToolTip="Close" AutomationProperties.Name="Close"
                                    Content="&#xE8BB;" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ContentHost" Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="24,0,24,20" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Themes.OgLauncher}" Value="True">
                                        <Setter Property="Margin" Value="18,16,18,18" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="136" />
                        </Grid.RowDefinitions>

                        <!-- ======================= HOME ======================= -->
                        <!-- Player hub, V-Bucks, Total Playtime, 7-Day Activity and Syndicate Achievements
                             (Views/HomeView.xaml). Seasons are picked on the Play tab. -->
                        <views:HomeView x:Name="HomeDashboard" Grid.Row="0" Grid.RowSpan="5">
                            <views:HomeView.Style>
                                <Style TargetType="views:HomeView">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHomeScreen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Themes.OgLauncher}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:HomeView.Style>
                        </views:HomeView>

                        <!-- ======================= OG LAUNCHER HOME ======================= -->
                        <!-- Themes > OG Fortnite Launcher: the classic launcher home. A game panel on the left (title,
                             welcome line, status, the big Launch button with a settings cog, community links), the
                             season art filling the right, and three news-style cards on the strip below. -->
                        <Grid Grid.Row="0" Grid.RowSpan="5" Margin="-18,-16,-18,-18" Background="{DynamicResource Tint_FF202020}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHomeScreen}" Value="True" />
                                                <Condition Binding="{Binding Themes.OgLauncher}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="330" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Art -->
                                <Grid Grid.Column="1" ClipToBounds="True">
                                    <Grid.Background>
                                        <ImageBrush ImageSource="Assets/ice-bg.jpg" Stretch="UniformToFill" />
                                    </Grid.Background>
                                    <Image Source="{Binding ActiveSeasonArt}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                                    <Rectangle Width="40" HorizontalAlignment="Left" IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="{DynamicResource TintColor_990D0D0D}" Offset="0" />
                                                <GradientStop Color="#000D0D0D" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock Text="SYNDICATE" FontFamily="{StaticResource DisplayFont}" FontSize="46"
                                               FontWeight="Bold" FontStyle="Italic" Foreground="#FFFFFF"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,10"
                                               IsHitTestVisible="False">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="0" Opacity="0.75" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>

                                <!-- Game panel -->
                                <Grid Grid.Column="0" ClipToBounds="True">
                                    <Image Source="{Binding ActiveSeasonArt}" Stretch="UniformToFill" Opacity="0.45"
                                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{DynamicResource TintColor_E6151515}" Offset="0" />
                                                <GradientStop Color="{DynamicResource TintColor_C4101010}" Offset="0.55" />
                                                <GradientStop Color="{DynamicResource TintColor_E6101010}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Fill="{DynamicResource Accent_14}" IsHitTestVisible="False" />

                                    <Grid Margin="38,62,38,22">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Syndicate" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="11" LineHeight="17" TextWrapping="Wrap"
                                                   Foreground="#C9C9C9"
                                                   Text="Welcome back! Pick a season on the Play tab, or launch straight into your current build." />

                                        <!-- Status line + selected build -->
                                        <Grid Grid.Row="3" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="BUILD: " FontSize="10.5" FontWeight="Bold" Foreground="#D6D6D6" />
                                                <TextBlock Text="{Binding BuildStateLabel}" FontSize="10.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Found">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BuildVersionText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="14" Foreground="{DynamicResource TextBrush}" ToolTip="{Binding BuildEraText}" />
                                        </Grid>

                                        <!-- Launch + cog -->
                                        <Grid Grid.Row="4" Height="56">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <Button Command="{Binding PlayCommand}" Content="Launch" ToolTip="{Binding PlayHint}"
                                                    ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Launch">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource OgLaunchButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Found">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Command="{Binding BrowseCommand}" Content="Select build"
                                                    AutomationProperties.Name="Select build folder">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource OgLaunchButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Found">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource OgLaunchButton}" Tag="Cog"
                                                    Command="{Binding ToggleSettingsCommand}" ToolTip="Game settings"
                                                    AutomationProperties.Name="Game settings">
                                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   FontSize="10" Foreground="#E8E9EC"
                                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />

                                        <Border Grid.Row="6" Height="1" Background="#26FFFFFF" Margin="0,22,0,14" />
                                        <StackPanel Grid.Row="7">
                                            <TextBlock Text="VISIT SYNDICATE ON:" FontSize="8.5" FontWeight="SemiBold" Foreground="#BDBDBD" />
                                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                <Button Style="{StaticResource OgLinkButton}" Content="&#xE8BD;" ToolTip="Discord"
                                                        Command="{Binding OpenCommunityCommand}" AutomationProperties.Name="Discord" />
                                                <Button Style="{StaticResource OgLinkButton}" Content="&#xE897;" ToolTip="Support"
                                                        Command="{Binding OpenSupportCommand}" AutomationProperties.Name="Support" />
                                                <Button Style="{StaticResource OgLinkButton}" Content="&#xE00B;" ToolTip="Donate"
                                                        Command="{Binding OpenDonateCommand}" AutomationProperties.Name="Donate" />
                                                <Button Style="{StaticResource OgLinkButton}" Content="&#xE716;" ToolTip="Credits"
                                                        Command="{Binding OpenCreditsCommand}" AutomationProperties.Name="Credits" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- News strip -->
                            <Grid Grid.Row="1" Height="178" HorizontalAlignment="Center" Margin="0,18,0,26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource OgNewsCard}" Content="CHAPTER 1 - ALL SEASONS" Tag="Read More"
                                        Command="{Binding OpenChapterCommand}" CommandParameter="1" AutomationProperties.Name="Chapter 1">
                                    <Button.Background>
                                        <ImageBrush ImageSource="Assets/chapter-1-bg.png" Stretch="UniformToFill" />
                                    </Button.Background>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource OgNewsCard}" Content="CHAPTER 2 - IN DEVELOPMENT" Tag="Read More"
                                        Command="{Binding OpenChapterCommand}" CommandParameter="2" AutomationProperties.Name="Chapter 2">
                                    <Button.Background>
                                        <ImageBrush ImageSource="Assets/chapter-2-bg.png" Stretch="UniformToFill" />
                                    </Button.Background>
                                </Button>
                                <Button Grid.Column="4" Style="{StaticResource OgNewsCard}" Content="JOIN THE SYNDICATE DISCORD" Tag="Visit Now"
                                        Command="{Binding OpenCommunityCommand}" AutomationProperties.Name="Discord">
                                    <Button.Background>
                                        <ImageBrush ImageSource="Assets/og-card.png" Stretch="UniformToFill" />
                                    </Button.Background>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- ======================= PLAY / SEASON BROWSER ======================= -->
                        <Grid x:Name="PlayScreen" Grid.Row="0" Grid.RowSpan="5"
                              Visibility="{Binding IsPlayScreen, Converter={StaticResource BoolToVis}}">
                            <Border x:Name="PlayShell" CornerRadius="12" BorderBrush="#24FFFFFF" BorderThickness="1"
                                    ClipToBounds="True" SizeChanged="RoundedClip_SizeChanged">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/ice-bg.jpg" Stretch="UniformToFill" Opacity="0.42" />
                                </Border.Background>
                                <Grid>
                                    <!-- BitmapCache on the season art: scaled once per season instead of being re-sampled
                                         whenever the timeline above it animates (Season Browser stutter). -->
                                    <Image Source="{Binding BrowserSeason.DetailArt}" Stretch="UniformToFill" Opacity="0.14"
                                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
                                        <Image.CacheMode><BitmapCache EnableClearType="False" /></Image.CacheMode>
                                    </Image>
                                    <Rectangle IsHitTestVisible="False" Fill="{Binding BrowserSeasonPageGradient}" />

                                    <Grid Margin="22,12,22,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header + chapter picker -->
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="26" Height="2" Background="{DynamicResource AccentBrush}"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Text="SEASON BROWSER" FontSize="7.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentSoftBrush}"
                                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="EVERY SEASON" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="34" FontWeight="Bold" FontStyle="Italic"
                                                           Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <ToggleButton x:Name="ChapterDrop" HorizontalAlignment="Right"
                                                          VerticalAlignment="Bottom" Height="42" Padding="16,0"
                                                          Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                          AutomationProperties.Name="Choose chapter">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Bd" CornerRadius="21" Background="{DynamicResource Tint_8C141414}"
                                                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                                                Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding BrowserChapterLabel}"
                                                                           FontFamily="{StaticResource DisplayFont}" FontSize="17"
                                                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                                                           FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                                                           Margin="12,2,0,0" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <Popup x:Name="ChapterPopup" IsOpen="{Binding IsChecked, ElementName=ChapterDrop}" StaysOpen="False"
                                                   AllowsTransparency="True" Placement="Bottom"
                                                   PlacementTarget="{Binding ElementName=ChapterDrop}"
                                                   HorizontalOffset="-230" VerticalOffset="6" PopupAnimation="Fade">
                                                <Border Width="340" Background="{DynamicResource Tint_F0141414}" BorderBrush="#33FFFFFF"
                                                        BorderThickness="1" CornerRadius="12" Padding="6">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="6" Opacity="0.55" />
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <Button Style="{StaticResource GhostButton}" Height="58" Margin="0,2"
                                                                HorizontalContentAlignment="Stretch"
                                                                Command="{Binding SelectBrowserChapterCommand}" CommandParameter="1"
                                                                Click="ChapterChoice_Click" AutomationProperties.Name="Chapter 1">
                                                            <Grid Margin="2,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="84" Height="52" CornerRadius="9"
                                                                        BorderBrush="#26FFFFFF" BorderThickness="1">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="Assets/chapter1-season1.jpg"
                                                                                    Stretch="UniformToFill" />
                                                                    </Border.Background>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="CHAPTER 1" FontFamily="{StaticResource DisplayFont}"
                                                                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="Seasons 0 - X  ·  Sep 2017 - Oct 2019"
                                                                               FontSize="10" Foreground="#9A9A9A" Margin="0,1,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostButton}" Height="58" Margin="0,2"
                                                                HorizontalContentAlignment="Stretch"
                                                                Command="{Binding SelectBrowserChapterCommand}" CommandParameter="2"
                                                                Click="ChapterChoice_Click" AutomationProperties.Name="Chapter 2">
                                                            <Grid Margin="2,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="84" Height="52" CornerRadius="9"
                                                                        BorderBrush="#26FFFFFF" BorderThickness="1">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="Assets/chapter2-season1.png"
                                                                                    Stretch="UniformToFill" />
                                                                    </Border.Background>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="CHAPTER 2" FontFamily="{StaticResource DisplayFont}"
                                                                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="Seasons 1 - 8  ·  Oct 2019 - Dec 2021"
                                                                               FontSize="10" Foreground="#9A9A9A" Margin="0,1,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>

                                        <!-- Selected season details -->
                                        <Border x:Name="BrowserDetailsCard" Grid.Row="1" CornerRadius="14"
                                                BorderBrush="#22FFFFFF" BorderThickness="1"
                                                ClipToBounds="True" Margin="0,0,0,10"
                                                SizeChanged="RoundedClip_SizeChanged">
                                            <Grid>
                                                <Image x:Name="BrowserArtBackdrop" Source="{Binding BrowserSeason.DetailArt}"
                                                       Stretch="UniformToFill" Opacity="0.28"
                                                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
                                                    <Image.CacheMode><BitmapCache EnableClearType="False" /></Image.CacheMode>
                                                </Image>
                                                <Rectangle IsHitTestVisible="False" Fill="{Binding BrowserSeasonDetailGradient}" />
                                                <Grid Margin="24,14,20,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="340" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel x:Name="BrowserText" VerticalAlignment="Center" MaxWidth="660">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding BrowserSeasonChapter}" FontSize="7.5"
                                                                       FontWeight="Bold" Foreground="{Binding BrowserSeasonAccentSoftBrush}" VerticalAlignment="Center" />
                                                            <Border Width="1" Height="10" Background="#33FFFFFF" Margin="10,0" />
                                                            <TextBlock Text="{Binding BrowserSeasonStatus}" FontSize="7.5"
                                                                       FontWeight="Bold" Foreground="{Binding BrowserSeasonAccentBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding BrowserSeasonLabel}" FontFamily="{StaticResource DisplayFont}"
                                                                   FontSize="42" FontWeight="Bold" FontStyle="Italic"
                                                                   Foreground="{Binding BrowserSeasonTitleBrush}" LineHeight="40" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding BrowserSeasonTagline}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{Binding BrowserSeasonAccentSoftBrush}" Margin="0,0,0,0" />
                                                        <TextBlock Text="{Binding BrowserSeasonDates}" FontSize="9.5"
                                                                   Foreground="#868686" Margin="0,5,0,0" />
                                                        <TextBlock Text="{Binding BrowserSeasonDescription}" FontSize="11.5"
                                                                   Foreground="#B4B4B4" TextWrapping="Wrap" MaxWidth="560"
                                                                   LineHeight="17" Margin="0,6,0,0" />
                                                        <ItemsControl ItemsSource="{Binding BrowserFeatures}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#14FFFFFF" BorderBrush="#26FFFFFF"
                                                                            BorderThickness="1" CornerRadius="10" Padding="9,4"
                                                                            Margin="0,0,6,6">
                                                                        <TextBlock Text="{Binding}" FontSize="8.5" FontWeight="SemiBold"
                                                                                   Foreground="#D2D2D2" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                            <Button Style="{StaticResource LaunchButton}" Height="44" MinWidth="168"
                                                                    Command="{Binding PlayBrowserCommand}"
                                                                    ToolTip="{Binding PlayHint}" ToolTipService.ShowOnDisabled="True"
                                                                    AutomationProperties.Name="Play season">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding BrowserPlayText}" FontSize="12"
                                                                               FontWeight="Bold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource GhostButton}" Height="44" Padding="16,0"
                                                                    Margin="10,0,0,0" Content="SELECT BUILD"
                                                                    Command="{Binding BrowserSelectBuildCommand}"
                                                                    IsEnabled="{Binding BrowserSeasonAvailable}"
                                                                    ToolTip="Select the build folder for this season."
                                                                    ToolTipService.ShowOnDisabled="True"
                                                                    AutomationProperties.Name="Select build folder" />
                                                            <TextBlock Text="This season is currently browse-only."
                                                                       FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                                       VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="210"
                                                                       TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding BrowserSeasonAvailable}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border x:Name="BrowserArtFrame" Grid.Column="1" CornerRadius="12"
                                                            BorderBrush="#26FFFFFF" BorderThickness="1" ClipToBounds="True"
                                                            Height="230" Margin="18,0,0,0" VerticalAlignment="Center"
                                                            SizeChanged="RoundedClip_SizeChanged">
                                                        <Image x:Name="BrowserArtCard" Source="{Binding BrowserSeason.DetailArt}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.CacheMode><BitmapCache EnableClearType="False" /></Image.CacheMode>
                                                        </Image>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Animated season timeline -->
                                        <Grid Grid.Row="2" Height="214">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource IconButton}" Width="40" Height="40"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Command="{Binding BrowserPreviousCommand}"
                                                    AutomationProperties.Name="Earlier season">
                                                <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="11" Foreground="{DynamicResource TextBrush}" />
                                            </Button>
                                            <controls:SeasonTimeline Grid.Column="1" x:Name="BrowserTimeline"
                                                                     ItemsSource="{Binding BrowserSeasons}"
                                                                     SelectedItem="{Binding BrowserSeason, Mode=TwoWay}"
                                                                     AutomationProperties.Name="Season timeline" />
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="40" Height="40"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Command="{Binding BrowserNextCommand}"
                                                    AutomationProperties.Name="Later season">
                                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="11" Foreground="{DynamicResource TextBrush}" />
                                            </Button>
                                        </Grid>

                                        <!-- Timeline slider -->
                                        <Slider x:Name="BrowserSlider" Grid.Row="3" Style="{StaticResource SeasonSlider}"
                                                Minimum="0" Maximum="{Binding BrowserMaxIndex}"
                                                Value="{Binding BrowserSliderValue, Mode=OneTime}"
                                                SmallChange="1" LargeChange="1"
                                                Margin="52,2,52,0" Height="24"
                                                AutomationProperties.Name="Season position" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ======================= CHAPTER PAGE ======================= -->
                        <Grid Grid.Row="0" Grid.RowSpan="5"
                              Visibility="{Binding IsChapterScreen, Converter={StaticResource BoolToVis}}">
                            <Border CornerRadius="12" BorderBrush="#24FFFFFF" BorderThickness="1" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/ice-bg.jpg" Stretch="UniformToFill" Opacity="0.38" />
                                </Border.Background>
                                <Grid>
                                    <Image Source="{Binding SelectedSeason.WheelPageBackgroundImage}"
                                           Stretch="UniformToFill" Opacity="0.82"
                                           RenderOptions.BitmapScalingMode="LowQuality"
                                           IsHitTestVisible="False" />
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{DynamicResource TintColor_CC0C0C0C}" Offset="0" />
                                                <GradientStop Color="{DynamicResource TintColor_660C0C0C}" Offset="0.45" />
                                                <GradientStop Color="{DynamicResource TintColor_E60A0A0A}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Fill="{StaticResource DotFieldBrush}" Opacity="0.32" IsHitTestVisible="False" />

                                    <Button Style="{StaticResource GhostButton}" Height="32" Padding="14,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,16,0,0"
                                            Command="{Binding BackToChaptersCommand}"
                                            AutomationProperties.Name="Back to chapters">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="BACK TO CHAPTERS" FontSize="9" FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <ToggleButton x:Name="ChapterPageDrop" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                  Margin="0,16,18,0" Height="42" Padding="16,0"
                                                  Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                  AutomationProperties.Name="Choose chapter">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bd" CornerRadius="21" Background="{DynamicResource Tint_8C141414}"
                                                        BorderBrush="#33FFFFFF" BorderThickness="1"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ChapterLabel}"
                                                                   FontFamily="{StaticResource DisplayFont}" FontSize="17"
                                                                   FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                                                   Margin="12,2,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <Popup x:Name="ChapterPagePopup" IsOpen="{Binding IsChecked, ElementName=ChapterPageDrop}"
                                           StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
                                           PlacementTarget="{Binding ElementName=ChapterPageDrop}"
                                           HorizontalOffset="-230" VerticalOffset="6" PopupAnimation="Fade">
                                        <Border Width="340" Background="{DynamicResource Tint_F0141414}" BorderBrush="#33FFFFFF"
                                                BorderThickness="1" CornerRadius="12" Padding="6">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="6" Opacity="0.55" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <Button Style="{StaticResource GhostButton}" Height="58" Margin="0,2"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding OpenChapterCommand}" CommandParameter="1"
                                                        Click="ChapterChoice_Click" AutomationProperties.Name="Chapter 1">
                                                    <Grid Margin="2,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="84" Height="52" CornerRadius="9"
                                                                BorderBrush="#26FFFFFF" BorderThickness="1">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="Assets/chapter1-season1.jpg"
                                                                            Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="CHAPTER 1" FontFamily="{StaticResource DisplayFont}"
                                                                       FontSize="18" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextBrush}" />
                                                            <TextBlock Text="Seasons 0 - X  ·  Sep 2017 - Oct 2019"
                                                                       FontSize="10" Foreground="#9A9A9A" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Height="58" Margin="0,2"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding OpenChapterCommand}" CommandParameter="2"
                                                        Click="ChapterChoice_Click" AutomationProperties.Name="Chapter 2">
                                                    <Grid Margin="2,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="84" Height="52" CornerRadius="9"
                                                                BorderBrush="#26FFFFFF" BorderThickness="1">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="Assets/chapter2-season1.png"
                                                                            Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="CHAPTER 2" FontFamily="{StaticResource DisplayFont}"
                                                                       FontSize="18" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextBrush}" />
                                                            <TextBlock Text="Seasons 1 - 8  ·  Oct 2019 - Dec 2021"
                                                                       FontSize="10" Foreground="#9A9A9A" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <Grid Margin="38,64,38,18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="2" Background="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center" />
                                                <TextBlock Text="SEASON SELECT" FontSize="7.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentSoftBrush}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ChapterLabel}" FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="46" FontWeight="Bold" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <Border Width="24" Height="1" Background="#4AFFFFFF" VerticalAlignment="Center" />
                                                <TextBlock Text="SELECT A SEASON" FontSize="8" FontWeight="Bold"
                                                           Foreground="#A4A4A4" Margin="10,0" VerticalAlignment="Center" />
                                                <Border Width="24" Height="1" Background="#4AFFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <ListBox Grid.Row="1" Margin="0,12,0,0"
                                                 Style="{StaticResource SeasonGridList}"
                                                 ItemsSource="{Binding Seasons}"
                                                 SelectedItem="{Binding SelectedSeason, Mode=TwoWay}"
                                                 ItemContainerStyle="{StaticResource SeasonGridItem}"
                                                 ItemTemplate="{StaticResource SeasonGridCard}"
                                                 AutomationProperties.Name="Seasons"
                                                 AutomationProperties.AutomationId="ChapterSeasonGrid"
                                                 AutomationProperties.HelpText="Select a season, then continue." />

                                        <Border Grid.Row="2" Margin="0,8,0,0" Padding="14,7" CornerRadius="10"
                                                Background="{DynamicResource Tint_D90A0A0A}"
                                                BorderBrush="#24FFFFFF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedSeasonHeading}"
                                                               FontFamily="{StaticResource DisplayFont}" FontSize="17"
                                                               FontWeight="Bold" FontStyle="Italic"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                        <Ellipse Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource DimTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedSeason.IsReleased}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding SelectedSeasonStatus}" FontSize="7.5" FontWeight="Bold"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedSeason.IsReleased}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="40"
                                                        MinWidth="156" Padding="18,0"
                                                        Command="{Binding OpenWheelSeasonCommand}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        AutomationProperties.Name="Continue with selected season">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   VerticalAlignment="Center" Margin="0,0,7,0"
                                                                   Visibility="{Binding CanChooseSeasonBuild, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding SeasonActionText}" FontSize="10" FontWeight="Bold"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button.ToolTip>
                                                        <TextBlock Text="{Binding SeasonActionHint}"
                                                                   TextWrapping="Wrap" MaxWidth="230" />
                                                    </Button.ToolTip>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ======================= SEASON PAGE ======================= -->
                        <Grid Grid.Row="0" Grid.RowSpan="5"
                              Visibility="{Binding IsSeasonScreen, Converter={StaticResource BoolToVis}}">
                            <Border CornerRadius="12" BorderBrush="#24FFFFFF" BorderThickness="1" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/ice-bg.jpg" Stretch="UniformToFill" Opacity="0.5" />
                                </Border.Background>
                                <Grid>
                                    <Grid IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSeason.SeasonPageArt}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Image Source="{Binding SelectedSeason.SeasonPageArt}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="{DynamicResource TintColor_E60D0D0D}" Offset="0" />
                                                    <GradientStop Color="{DynamicResource TintColor_C70D0D0D}" Offset="0.28" />
                                                    <GradientStop Color="{DynamicResource TintColor_4D0D0D0D}" Offset="0.58" />
                                                    <GradientStop Color="#00070E17" Offset="0.85" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00070E17" Offset="0.46" />
                                                    <GradientStop Color="{DynamicResource TintColor_990D0D0D}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                    <!-- Number-ring artwork: only for a season with no key art. -->
                                    <Grid IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSeason.SeasonPageArt}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                    <Rectangle Fill="{Binding SelectedSeason.CoverBrush}" Opacity="0.55" IsHitTestVisible="False" />
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{DynamicResource TintColor_B30A0A0A}" Offset="0" />
                                                <GradientStop Color="{DynamicResource TintColor_330A0A0A}" Offset="0.42" />
                                                <GradientStop Color="{DynamicResource TintColor_F20A0A0A}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Fill="{StaticResource DotFieldBrush}" Opacity="0.4" IsHitTestVisible="False" />
                                    <Grid Width="430" Height="520" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,20,0" IsHitTestVisible="False">
                                        <Ellipse Width="430" Height="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#24F2F3F5" Offset="0" />
                                                    <GradientStop Color="#0B4C4C4C" Offset="0.55" />
                                                    <GradientStop Color="#003BD9FF" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="356" Height="356" Stroke="#4DD3D3D3" StrokeThickness="1"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse Width="300" Height="300" Stroke="#33FFFFFF" StrokeThickness="1"
                                                 StrokeDashArray="1,7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-18" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="420" Height="420" Stroke="{DynamicResource Accent_22}" StrokeThickness="1"
                                                 StrokeDashArray="2,14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="25" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Canvas Width="430" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Fill="#454545" Opacity="0.8"
                                                  Data="M 388,126 L 405,153 L 392,184 L 378,154 Z" />
                                            <Path Fill="#383838" Opacity="0.85"
                                                  Data="M 42,322 L 55,342 L 44,367 L 32,343 Z" />
                                            <Path Fill="#565656" Opacity="0.55"
                                                  Data="M 362,352 L 371,369 L 364,386 L 355,370 Z" />
                                            <Path Fill="#454545" Opacity="0.45"
                                                  Data="M 71,150 L 79,165 L 71,181 L 63,165 Z" />
                                            <Path Stroke="#4DFFFFFF" StrokeThickness="1"
                                                  Data="M 28,260 A 187,187 0 0 1 402,260" Opacity="0.65" />
                                            <Path Stroke="#33D3D3D3" StrokeThickness="1"
                                                  Data="M 402,260 A 187,187 0 0 1 28,260" Opacity="0.28" />
                                        </Canvas>
                                        <TextBlock Text="{Binding SelectedSeason.Code}"
                                                   FontFamily="{StaticResource DisplayFont}" FontSize="210"
                                                   FontWeight="Bold" FontStyle="Italic" Foreground="#F4F5F6"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Opacity="0.92" />
                                    </Grid>
                                    </Grid>

                                    <Button Style="{StaticResource GhostButton}" Height="32" Padding="14,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,16,0,0"
                                            Command="{Binding BackToSeasonsCommand}"
                                            AutomationProperties.Name="Back to seasons">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="BACK TO SEASONS" FontSize="9" FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0"
                                            Padding="11,5" CornerRadius="12" Background="{DynamicResource Tint_991D1D1D}"
                                            BorderBrush="{DynamicResource Accent_33}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="RELEASED" FontSize="7.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessBrush}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Width="600" Margin="38,104,0,0">
                                        <TextBlock Text="{Binding SelectedSeason.Name}" FontFamily="{StaticResource BurbankFont}"
                                                   FontSize="64" FontWeight="Bold" FontStretch="Condensed" FontStyle="Normal"
                                                   Foreground="#FFFFFF" LineHeight="64" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding SelectedSeason.Tagline}" FontFamily="{StaticResource BurbankFont}"
                                                   FontSize="24" FontWeight="Bold" FontStretch="Condensed" FontStyle="Normal"
                                                   Foreground="#E6E6E6" Margin="3,8,0,0" />
                                        <Border Width="44" Height="2" Background="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Left" Margin="3,13,0,0" Opacity="0.85" />
                                    </StackPanel>

                                    <Border VerticalAlignment="Bottom" Margin="16,0,16,16"
                                            CornerRadius="10" Background="{DynamicResource Tint_E6151515}"
                                            BorderBrush="#26FFFFFF" BorderThickness="1">
                                        <Grid Margin="20,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="ABOUT THIS SEASON" FontSize="7.5" FontWeight="Bold"
                                                           Foreground="#868686" />
                                                <TextBlock Text="{Binding SelectedSeason.Description}" FontSize="11"
                                                           Foreground="#D6D6D6" TextWrapping="Wrap" LineHeight="17"
                                                           MaxWidth="560" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="9.5"
                                                           Foreground="#E8E9EC" TextWrapping="Wrap" MaxWidth="560"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="25,0,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="SEASON BUILD" FontSize="7.5" FontWeight="Bold"
                                                               Foreground="#868686" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding BuildVersionText}" FontFamily="{StaticResource DisplayFont}"
                                                               FontSize="12" FontWeight="Bold" FontStyle="Italic"
                                                               Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding BuildStateLabel}" FontSize="9" FontWeight="Bold"
                                                               Foreground="#E8E9EB" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DisplayPath}" FontSize="8.5"
                                                           Foreground="#8F8F8F" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayPath}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding BuildStateDetail}" FontSize="8.5"
                                                           Foreground="#8F8F8F" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding BuildStateDetail}" Margin="0,2,0,0" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                                                    <Button Style="{StaticResource GhostButton}" Height="42"
                                                            Padding="15,0" FontSize="9" Content="CHANGE BUILD"
                                                            Command="{Binding ChooseSeasonBuildCommand}" />
                                                    <Button Style="{StaticResource LaunchButton}" Height="46"
                                                            MinWidth="174" Margin="8,0,0,0"
                                                            Command="{Binding PlayCommand}"
                                                            ToolTip="{Binding PlayHint}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            AutomationProperties.Name="Play season">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                                       FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="PLAY SEASON" FontFamily="{StaticResource DisplayFont}"
                                                                       FontSize="14" FontWeight="Bold" FontStyle="Italic"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>


                        <!-- ======================= STUDIO PAGE (dev launcher) ======================= -->
                        <!-- Key art (pre-blurred, Assets/studio-keyart.jpg) with the copy and OPEN STUDIO on the left.
                             MainWindow.xaml.cs animates it in (camera push + copy lift) and on OPEN STUDIO (zoom + flash). -->
                        <Grid Grid.Row="0" Grid.RowSpan="5"
                              Visibility="{Binding IsStudioScreen, Converter={StaticResource BoolToVis}}"
                              AutomationProperties.Name="Studio">
                            <Border CornerRadius="12" BorderBrush="#24FFFFFF" BorderThickness="1" ClipToBounds="True"
                                    Background="{DynamicResource Tint_FF0C0C0C}">
                                <Grid>
                                    <Image Source="Assets/studio-keyart.jpg" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.62,0.45"
                                           IsHitTestVisible="False">
                                        <Image.RenderTransform>
                                            <ScaleTransform x:Name="StudioArtZoom" ScaleX="1.04" ScaleY="1.04" />
                                        </Image.RenderTransform>
                                    </Image>
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="{DynamicResource TintColor_E60A0A0A}" Offset="0" />
                                                <GradientStop Color="{DynamicResource TintColor_990D0D0D}" Offset="0.42" />
                                                <GradientStop Color="{DynamicResource TintColor_0F0B0B0B}" Offset="0.8" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.45" />
                                                <GradientStop Color="{DynamicResource TintColor_CC0C0C0C}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle x:Name="StudioFlash" Fill="#FFFFFF" Opacity="0" IsHitTestVisible="False" />

                                    <Border Width="46" Height="46" CornerRadius="10" ClipToBounds="True"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,28,0"
                                            BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="False">
                                        <Image Source="Assets/logo.png" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel x:Name="StudioCopy" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Margin="44,0,44,40" MaxWidth="520">
                                        <Border HorizontalAlignment="Left" CornerRadius="4" Padding="10,4"
                                                Background="{DynamicResource Accent_1F}" BorderBrush="{DynamicResource Accent_55}"
                                                BorderThickness="1">
                                            <TextBlock Text="DEV LAUNCHER  ·  MAP EDITOR" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBlock Text="SYNDICATE" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                                   FontWeight="Bold" FontStyle="Italic" Foreground="#D8D8D8" Margin="2,16,0,0" />
                                        <TextBlock Text="STUDIO" FontFamily="{StaticResource DisplayFont}" FontSize="70"
                                                   FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource TextBrush}"
                                                   Margin="0,-14,0,0">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="0" Opacity="0.55" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock FontSize="12.5" Foreground="#D2D2D2" TextWrapping="Wrap" LineHeight="18" Margin="2,4,0,0"
                                                   Text="Start a match on any Chapter 1 season, fly around the island and edit the map live. Your game docks inside the editor, with the Outliner, Details and Content Browser around it." />
                                        <WrapPanel Margin="0,16,0,0">
                                            <Border CornerRadius="4" Padding="9,5" Margin="0,0,8,8" Background="#26FFFFFF">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Outliner &amp; Details" FontSize="10.5" Foreground="#E8E8E8" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="4" Padding="9,5" Margin="0,0,8,8" Background="#26FFFFFF">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Live map editing" FontSize="10.5" Foreground="#E8E8E8" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="4" Padding="9,5" Margin="0,0,8,8" Background="#26FFFFFF">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE709;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Fly &amp; free cam" FontSize="10.5" Foreground="#E8E8E8" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button x:Name="StudioOpenButton" Style="{StaticResource LaunchButton}" Height="50"
                                                    MinWidth="200" Click="OnOpenStudio" AutomationProperties.Name="Open Studio">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="OPEN STUDIO" FontFamily="{StaticResource DisplayFont}"
                                                               FontSize="15" FontWeight="Bold" FontStyle="Italic"
                                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Pick the season and press Start inside the Studio.&#10;The Syndicate menu stays off in Studio sessions."
                                                       FontSize="10" Foreground="#9A9A9A" LineHeight="15" Margin="18,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>


                        <!-- ======================= CREDITS PAGE ======================= -->
                        <Grid Grid.Row="0" Grid.RowSpan="5"
                              Visibility="{Binding IsCreditsScreen, Converter={StaticResource BoolToVis}}"
                              AutomationProperties.Name="Credits">
                            <Grid.Resources>
                                <Style x:Key="CreditsCard" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Tint_D9161616}" />
                                    <Setter Property="BorderBrush" Value="#24FFFFFF" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="12" />
                                    <Setter Property="Padding" Value="22,16" />
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                </Style>
                                <Style x:Key="CreditsSectionTitle" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                                    <Setter Property="FontSize" Value="19" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Style>
                                <Style x:Key="CreditsName" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                                    <Setter Property="FontSize" Value="13.5" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Style>
                                <Style x:Key="CreditsCopy" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                                    <Setter Property="FontSize" Value="10" />
                                    <Setter Property="Foreground" Value="#B0B0B0" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="LineHeight" Value="14.5" />
                                </Style>
                                <Style x:Key="CreditsAvatar" TargetType="Border">
                                    <Setter Property="Width" Value="34" />
                                    <Setter Property="Height" Value="34" />
                                    <Setter Property="CornerRadius" Value="17" />
                                    <Setter Property="Background" Value="{DynamicResource Accent_16}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent_33}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                </Style>
                                <Style x:Key="CreditsRule" TargetType="Border">
                                    <Setter Property="Height" Value="1" />
                                    <Setter Property="Background" Value="#12FFFFFF" />
                                    <Setter Property="Margin" Value="42,9,0,9" />
                                </Style>
                            </Grid.Resources>
                            <Border CornerRadius="12" BorderBrush="#24FFFFFF" BorderThickness="1" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/ice-bg.jpg" Stretch="UniformToFill" Opacity="0.24" />
                                </Border.Background>
                                <Grid>
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource TintColor_F2101010}" Offset="0" />
                                                <GradientStop Color="{DynamicResource TintColor_E6131313}" Offset="0.52" />
                                                <GradientStop Color="{DynamicResource TintColor_F50C0C0C}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Ellipse Width="600" Height="440" HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,-190,-140,0" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#18F2F3F5" Offset="0" />
                                                <GradientStop Color="#003BD9FF" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Rectangle Fill="{StaticResource DotFieldBrush}" Opacity="0.22" IsHitTestVisible="False" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PanningMode="VerticalOnly">
                                        <StackPanel Margin="36,24,32,24">
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="26" Height="2" Background="{DynamicResource AccentBrush}"
                                                                VerticalAlignment="Center" />
