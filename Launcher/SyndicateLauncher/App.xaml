<Application x:Class="SyndicateLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SyndicateLauncher.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
                <ResourceDictionary Source="Resources/ThemeSlots.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:StateToVisibilityConverter x:Key="StateToVis" />
            <conv:IntEqualsConverter x:Key="IntEquals" />
            <conv:TierBrushConverter x:Key="TierBrush" />
            <conv:BadgeGlyphConverter x:Key="BadgeGlyph" />
            <conv:FractionToLengthConverter x:Key="FractionToLength" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
